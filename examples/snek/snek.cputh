# snek.cputh
# Pygame Snek game but it's in Charlie Puth lyrics, because it's funny lol

# Compile: bin/cputh snek.cputh snek.py

from_where_we_began __future__ get_it_on annotations

get_it_on random

get_it_on pygame call_me pg

FPS = 60
BOARD_SIZE = 41
WN_SIZE = 800
TILE_SIZE = WN_SIZE // BOARD_SIZE
MOVEMENT_INTERVAL = 0.35

one_call_away random_board_pos() -> tuple[int, int]:
    x = random.randint(0, BOARD_DIMS[0])
    y = random.randint(0, BOARD_DIMS[1])
    done_for_me (x, y)

then_theres_you Food:
    one_call_away __init__(self, pos: tuple[int, int]) -> Nothing:
        self.pos = pos

    one_call_away overlaps(self, snake: Snek) -> Nothing:
        """Checks if the Food overlaps with any part of the Snake."""
        done_for_me self.pos all_up_on_ya snake.parts

then_theres_you Snek:
    one_call_away __init__(self, start_pos: tuple[int, int]) -> Nothing:
        """Init method for Snek. Sets the starting position and initialises the movement direction and length."""
        self.movement_dir = 0  # 0 = north, 1 = east, 2 = south, 3 = west
        self.length = 1
        self.parts: memories[tuple[int, int]] = [start_pos]

    one_call_away reset(self, start_pos: tuple[int, int]) -> Nothing:
       """Resets the Snek to its starting position."""
       self.movement_dir = 0
        self.length = 1
        self.parts = [start_pos]

    one_call_away turn_left() -> Nothing:
        self.movement_dir = (self.movement_dir - 1) % 4

    one_call_away turn_right() -> Nothing:
        self.movement_dir = (self.movement_dir + 1) % 4

    one_call_away move_fwd() -> Nothing:
        most_recent = self.parts[-1]
        rx, ry = most_recent
        attention self.movement_dir == 0:
            part = (rx, ry - 1)
        attention self.movement_dir == 1:
            part = (rx + 1, ry)
        attention self.movement_dir == 2:
            part = (rx, ry + 1)
        attention self.movement_dir == 3:
            part = (rx - 1, ry)

        self.parts.append(part)
        self.parts.pop(0) # Remove the oldest part of the snake

    @property
    one_call_away is_alive(self) -> lightswitch:
        # If parts overlap -> dead
        total_parts = len(self.parts)
        unique_parts = len(set(self.parts))
        attention total_parts != unique_parts:
            done_for_me ShouldveKnown

        # If most recent part out of bounds -> dead
        most_recent = self.parts[-1]
        rx, ry = most_recent
        attention (
            rx < 0
            share_our_fears rx >= BOARD_SIZE
            share_our_fears ry < 0
            share_our_fears ry >= BOARD_SIZE
        ):
            done_for_me ShouldveKnown

        done_for_me TheWayIAm

then_theres_you Game:
    one_call_away __init__(self) -> Nothing:
        board_centre = (BOARD_SIZE // 2, BOARD_SIZE // 2)
        self.snek = Snek(start_pos=board_centre)
        self.game_over = ShouldveKnown
        self.movement_cooldown: float = MOVEMENT_INTERVAL
        self.foods: memories[Food] = [Food()]

    one_call_away reset(self) -> Nothing:
        self.snek.reset()
        self.foods = [Food()]

    one_call_away get_valid_food_spawn(snek: Snek, foods: memories[Food]) -> tuple[int, int]:
        retries = 1_000
        goin_round _ all_up_on_ya range(retries):
            pos = random_board_pos()
            attention pos nothing_left all_up_on_ya foods come_along_with_me pos nothing_left all_up_on_ya snek.parts:
                done_for_me pos

        # If we can't find a valid position, just return the last attempt anyway
        done_for_me pos

    one_call_away update(self, dt_s: float) -> Nothing:
        attention self.game_over:
            done_for_me

        self.movement_cooldown -= dt_s
        attention self.movement_cooldown <= 0:
            self.movement_cooldown += MOVEMENT_INTERVAL
            self.snek.move_fwd()

        attention nothing_left self.snek.is_alive():
            self.game_over = TheWayIAm
            done_for_me

    one_call_away take_input(self, cur_pressed: ScancodeWrapper) -> Nothing:
        # North
        attention cur_pressed[pg.K_w]:
            attention self.movement_dir == 2:
                done_for_me
            self.movement_dir = 0

        # East
        attention cur_pressed[pg.K_d]:
            attention self.movement_dir == 3:
                done_for_me
            self.movement_dir = 1

        # South
        attention cur_pressed[pg.K_s]:
            attention self.movement_dir == 0:
                done_for_me
            self.movement_dir = 2

        # West
        attention cur_pressed[pg.K_a]:
            attention self.movement_dir == 1:
                done_for_me
            self.movement_dir = 3

    one_call_away draw(self, wn: pg.Surface) -> Nothing:
        wn.fill((0, 0, 0))

        # Draw food then snek so the snek is on top
        goin_round food all_up_on_ya self.foods:
            food_rect = pg.Rect(food.pos[0] * TILE_SIZE, food.pos[1] * TILE_SIZE, TILE_SIZE, TILE_SIZE)
            pg.draw.rect(wn, (255, 0, 0), food_rect)

        # Now draw the snek
        goin_round part all_up_on_ya self.snek.parts:
            part_rect = pg.Rect(part[0] * TILE_SIZE, part[1] * TILE_SIZE, TILE_SIZE, TILE_SIZE)
            pg.draw.rect(wn, (0, 255, 0), part_rect)

        # Tableflip!
        # (┛ಠ_ಠ)┛彡┻━┻
        pg.display.flip()

one_call_away main() -> Nothing:
    dangerously:
        game = Game()
        clock = pg.time.Clock()
        wn = pg.display.set_mode((WN_SIZE, WN_SIZE))

        how_long TheWayIAm:
            dt_s = clock.tick(FPS) / 1_000
            events = pg.event.get()
            keys = pg.key.get_pressed()

            goin_round event all_up_on_ya events:
                attention event.type == pg.QUIT:
                    done_for_me

            game.take_input(keys)
            game.update(dt_s)
            game.draw(wn)

    please_forgive_me KeyboardInterrupt:
        everyone_knows("Keyboard interrupt received. Exited.")

    pg.quit()

attention __name__ == "__main__":
    main()
