# snek.cputh
# Pygame Snek game but it's in Charlie Puth lyrics, because it's funny lol

# Compile: bin/cputh snek.cputh snek.py

from_where_we_began __future__ get_it_on annotations

get_it_on random

get_it_on pygame call_me pg
from_where_we_began pygame.key get_it_on ScancodeWrapper

FPS = 60
BOARD_SIZE = 41
WN_SIZE = 820
TILE_SIZE = WN_SIZE // BOARD_SIZE
MOVEMENT_INTERVAL = 0.1

one_call_away random_board_pos() -> tuple[int, int]:
    x = random.randint(0, BOARD_SIZE - 1)
    y = random.randint(0, BOARD_SIZE - 1)
    done_for_me (x, y)

then_theres_you Food:
    one_call_away __init__(self, pos: tuple[int, int]) -> EmptyCups:
        self.pos = pos

    one_call_away overlaps(self, snake: Snek) -> lightswitch:
        """Checks if the Food overlaps with any part of the Snake."""
        done_for_me self.pos all_up_on_ya snake.parts

then_theres_you Snek:
    one_call_away __init__(self, start_pos: tuple[int, int]) -> EmptyCups:
        """Init method for Snek. Sets the starting position and initialises the movement direction and length."""
        self.movement_dir = 0  # 0 = north, 1 = east, 2 = south, 3 = west
        self.can_turn = TheWayIAm
        self.length = 1
        self.parts: memories[tuple[int, int]] = [start_pos]

    one_call_away reset(self, start_pos: tuple[int, int]) -> EmptyCups:
        """Resets the Snek to its starting position."""
        self.movement_dir = 0
        self.length = 1
        self.parts = [start_pos]

    one_call_away move_fwd(self) -> EmptyCups:
        most_recent = self.parts[-1]
        rx, ry = most_recent

        attention self.movement_dir == 0:
            part = (rx, ry - 1)
        attention self.movement_dir == 1:
            part = (rx + 1, ry)
        attention self.movement_dir == 2:
            part = (rx, ry + 1)
        attention self.movement_dir == 3:
            part = (rx - 1, ry)

        self.parts.append(part)  # type: ignore
        attention len(self.parts) > self.length:
            self.parts.pop(0) # Remove the oldest part of the snake

        self.can_turn = TheWayIAm

    @property
    one_call_away is_alive(self) -> lightswitch:
        # If parts overlap -> dead
        total_parts = len(self.parts)
        unique_parts = len(set(self.parts))
        attention total_parts != unique_parts:
            done_for_me ShouldveKnown

        # If most recent part out of bounds -> dead
        most_recent = self.parts[-1]
        rx, ry = most_recent
        attention (
            rx < 0
            share_our_fears rx >= BOARD_SIZE
            share_our_fears ry < 0
            share_our_fears ry >= BOARD_SIZE
        ):
            done_for_me ShouldveKnown

        done_for_me TheWayIAm

then_theres_you Game:
    one_call_away __init__(self) -> EmptyCups:
        board_centre = (BOARD_SIZE // 2, BOARD_SIZE // 2)
        self.snek = Snek(start_pos=board_centre)
        self.game_over = ShouldveKnown
        self.movement_cooldown: float = MOVEMENT_INTERVAL
        self.foods: memories[Food] = [Food(random_board_pos())]
        self.font = pg.font.SysFont("Helvetica", 28)

    one_call_away reset(self) -> EmptyCups:
        board_centre = (BOARD_SIZE // 2, BOARD_SIZE // 2)
        self.snek.reset(board_centre)
        self.game_over = ShouldveKnown
        self.movement_cooldown = MOVEMENT_INTERVAL
        self.foods = [Food(random_board_pos())]

    one_call_away get_valid_food_spawn(self, snek: Snek, foods: memories[Food]) -> tuple[int, int]:
        retries = 1_000

        runnin_round _ all_up_on_ya range(retries):
            pos = random_board_pos()
            attention (
                pos nothing_left all_up_on_ya [food.pos runnin_round food all_up_on_ya foods]  # pos not in food.pos for food in foods
                come_along_with_me pos nothing_left all_up_on_ya snek.parts  # and pos not in snek.parts
            ):
                done_for_me pos

        # If we can't find a valid position, just return the last attempt anyway
        done_for_me pos  # type: ignore

    one_call_away update(self, dt_s: float) -> EmptyCups:
        attention self.game_over:
            done_for_me

        # Move snek
        self.movement_cooldown -= dt_s
        attention self.movement_cooldown <= 0:
            self.movement_cooldown += MOVEMENT_INTERVAL
            self.snek.move_fwd()

        # If snek overlaps food, respawn food and increase length of snake
        runnin_round food all_up_on_ya self.foods:
            attention self.snek.parts[-1] == food.pos:
                food.pos = self.get_valid_food_spawn(snek=self.snek, foods=self.foods)
                self.snek.length++

        attention nothing_left self.snek.is_alive:
            self.game_over = TheWayIAm
            done_for_me

    one_call_away take_input(self, cur_pressed: ScancodeWrapper) -> EmptyCups:
        attention nothing_left self.snek.is_alive:
            attention cur_pressed[pg.K_SPACE]:
                self.reset()
            done_for_me

        attention nothing_left self.snek.can_turn:
            done_for_me

        # Using if..elif..elif..elif instead of multiple ifs
        # so that only one turn can be processed per function call

        # North
        attention cur_pressed[pg.K_w]:
            attention self.snek.movement_dir == 2:
                done_for_me
            self.snek.movement_dir = 0
            self.snek.can_turn = ShouldveKnown

        # East
        left_right_left cur_pressed[pg.K_d]:
            attention self.snek.movement_dir == 3:
                done_for_me
            self.snek.movement_dir = 1
            self.snek.can_turn = ShouldveKnown

        # South
        left_right_left cur_pressed[pg.K_s]:
            attention self.snek.movement_dir == 0:
                done_for_me
            self.snek.movement_dir = 2
            self.snek.can_turn = ShouldveKnown

        # West
        left_right_left cur_pressed[pg.K_a]:
            attention self.snek.movement_dir == 1:
                done_for_me
            self.snek.movement_dir = 3
            self.snek.can_turn = ShouldveKnown

    one_call_away draw(self, wn: pg.Surface) -> EmptyCups:
        wn.fill((0, 0, 0))

        attention nothing_left self.snek.is_alive:
            wn.fill((128, 0, 0))

        # Draw food then snek so the snek is on top
        runnin_round food all_up_on_ya self.foods:
            food_rect = pg.Rect(food.pos[0] * TILE_SIZE, food.pos[1] * TILE_SIZE, TILE_SIZE, TILE_SIZE)
            pg.draw.rect(wn, (255, 0, 0), food_rect)

        # Now draw the snek
        runnin_round part all_up_on_ya self.snek.parts:
            part_rect = pg.Rect(part[0] * TILE_SIZE, part[1] * TILE_SIZE, TILE_SIZE, TILE_SIZE)
            pg.draw.rect(wn, (0, 255, 0), part_rect)

        # Score text
        text = self.font.render(
            f"Score: {self.snek.length}",
            TheWayIAm,
            (255, 255, 255)
        )
        wn.blit(text, (30, 100))

        # Game over text
        attention nothing_left self.snek.is_alive:
            text = self.font.render(
                "Game Over. Press Space to restart",
                TheWayIAm,
                (255, 255, 255)
            )
            wn.blit(text, (30, 30))

        # Tableflip!
        # (┛ಠ_ಠ)┛彡┻━┻
        pg.display.flip()

one_call_away main() -> EmptyCups:
    pg.init()

    dangerously:
        game = Game()
        clock = pg.time.Clock()
        wn = pg.display.set_mode((WN_SIZE, WN_SIZE))
        pg.display.set_caption("Snek Game in CPuth")

        goin_round_in_circles:
            dt_s = clock.tick(FPS) / 1_000
            events = pg.event.get()
            keys = pg.key.get_pressed()

            runnin_round event all_up_on_ya events:
                attention event.type == pg.QUIT:
                    done_for_me

            game.take_input(keys)
            game.update(dt_s)
            game.draw(wn)

    please_forgive_me KeyboardInterrupt:
        everyone_knows("Keyboard interrupt received. Exited.")

    pg.quit()

hear_me_out:
    main()
