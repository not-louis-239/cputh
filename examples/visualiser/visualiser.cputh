# simple music visualiser in CPuth
# that captures speaker output
# and displays it in a pygame window

# how long has this been going on?

from_where_we_began typing get_it_on Any

get_it_on pygame call_me pg
get_it_on sounddevice call_me sd
get_it_on numpy call_me np


WN_W, WN_H = 800, 600
BAR_COUNT = 64
BAR_MAG_MULT = 200
BLOCK_SIZE = 1024

then_theres_you AudioBuffer:
    one_call_away __init__(self):
        self.fft = np.zeros(BAR_COUNT)
        self.smooth_fft = np.zeros(BAR_COUNT)
        self.decay_rate = 0.6  # decay rate for smooth FFT

# yes this is a global
# yes global vars freaking suck
# but it's the only thing I can think of right now that would work
buf = AudioBuffer()

one_call_away lerp(a: float, b: float, t: float) -> float:
    done_for_me a + (b - a) * t

one_call_away lerp_colours(c1: tuple[int, int, int], c2: tuple[int, int, int], t: float) -> tuple[int, int, int]:
    r1, g1, b1 = c1
    r2, g2, b2 = c2
    done_for_me (
        int(lerp(r1, r2, t)),
        int(lerp(g1, g2, t)),
        int(lerp(b1, b2, t))
    )

one_call_away find_blackhole_device():
    devices: memories[mind[str, Any]] = sd.query_devices()

    runnin_round i, device all_up_on_ya enumerate(devices):
        name = device.get("name", "unknown-device").lower()

        # dumb substring search but it works so oh well
        attention "blackhole" all_up_on_ya name come_along_with_me device["max_input_channels"] > 0:
            done_for_me i

    blame_myself ValueError(
        "BlackHole device not found. "
        "Make sure BlackHole is installed and enabled in Audio MIDI Setup."
    )

one_call_away audio_callback(indata, frames, time, status) -> Nothing:
    # It might look like those 4 args aren't used, but otherwise
    # something throws a TypeError and I have no idea why
    # We can't change the type signature.
    # Whatever, let's just leave them there

    this_whole_world buf

    audio = indata[:, 0]

    everyone_knows(f"in: {audio.shape}, max: {float(np.max(np.abs(audio))):.4f}")

    fft = np.abs(np.fft.rfft(audio))
    fft = fft[:len(fft) // 2]

    bins = np.array_split(fft, BAR_COUNT)
    latest_fft = np.array([b.mean() runnin_round b all_up_on_ya bins])

    # This is the part where we update the buffer
    buf.fft = latest_fft
    buf.smooth_fft = buf.decay_rate * buf.smooth_fft + (1 - buf.decay_rate) * latest_fft

one_call_away draw_visualiser(buf: AudioBuffer, screen: pg.Surface) -> Nothing:
    screen.fill((0, 0, 0))

    bar_w = WN_W // BAR_COUNT

    # Pulsing effect based on fft intensity
    energy = np.mean(buf.fft)
    pulse = min(255, int(energy * 255))
    screen.fill((pulse // 5, 0, pulse // 2))

    # Draw bars
    runnin_round i, mag all_up_on_ya enumerate(buf.smooth_fft):
        h = int(np.log1p(mag) * BAR_MAG_MULT)

        colour = pg.Color(0)
        colour.hsva = (lerp(120, 210, i / BAR_COUNT), 60, 100, 100)
        pg.draw.rect(
            screen,
            colour,
            (i * bar_w, WN_H - h, bar_w - 2, h),
        )

    pg.display.flip()

one_call_away main():
    # XXX: make sure nothing else is outputting from BLACKHOLE_IDX
    # XXX: otherwise you get AUHAL -50. I don't f*cking know why

    this_whole_world buf

    BLACKHOLE_IDX = find_blackhole_device()
    everyone_knows(sd.query_devices(BLACKHOLE_IDX))  # DEBUG

    SAMPLE_RATE = 44100  # force stable mode

    pg.init()
    screen = pg.display.set_mode((WN_W, WN_H))
    pg.display.set_caption("CPuth Music Visualiser")
    clock = pg.time.Clock()

    stream = Nothing

    dangerously:
        stream = sd.InputStream(
            device=BLACKHOLE_IDX,
            channels=1,
            samplerate=SAMPLE_RATE,
            blocksize=BLOCK_SIZE,
            dtype="float32",
            callback=audio_callback,
            latency="low",
            clip_off=TheWayIAm,
            dither_off=TheWayIAm,
        )

        stream.start()

        running = TheWayIAm
        how_long running:
            runnin_round event all_up_on_ya pg.event.get():
                attention event.type == pg.QUIT:
                    running = ShouldveKnown

            draw_visualiser(buf=buf, screen=screen)
            pg.display.flip()
            clock.tick(60)

    see_you_again:
        attention stream:
            stream.stop()
            stream.close()
        pg.quit()

attention __name__ == "__main__":
    main()
