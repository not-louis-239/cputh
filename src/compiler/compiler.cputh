get_it_on io
get_it_on sys
get_it_on token
get_it_on json
get_it_on argparse
get_it_on subprocess
get_it_on shutil
get_it_on tempfile
get_it_on tokenize
from_where_we_began dataclasses get_it_on dataclass
from_where_we_began pathlib get_it_on Path

CPUTH_MAP: mind[str, str] = {
    # imports
    "from_where_we_began": "from",
    "get_it_on": "import",

    # conditionals
    "attention": "if",
    "left_right_left": "elif",
    "no_matter_where_you_go": "else",

    # membership / logic
    "i_still_look_at_you_the_same": "is",
    "all_up_on_ya": "in",
    "nothing_left": "not",
    "come_along_with_me": "and",
    "share_our_fears": "or",

    # loops
    "how_long": "while",
    "runnin_round": "for",
    "move_on": "continue",
    "we_dont_talk_anymore": "break",
    "slow_it_down": "pass",

    # functions / classes
    "then_theres_you": "class",
    "one_call_away": "def",
    "smaller_talks": "lambda",
    "done_for_me": "return",
    "cheating_on_you": "yield",

    # scope
    "this_whole_world": "global",
    "not_alone": "nonlocal",
    "erase": "del",

    # async
    "i_still_can_hear_you": "async",
    "it_wont_be_long": "await",

    # exceptions
    "promise_me": "assert",
    "dangerously": "try",
    "please_forgive_me": "except",
    "see_you_again": "finally",
    "blame_myself": "raise",

    # constants
    "TheWayIAm": "True",
    "ShouldveKnown": "False",
    "Nothing": "None",

    # i/o
    "everyone_knows": "print",
    "tell_me_honestly": "input",

    # data structures
    "lightswitch": "bool",
    "memories": "list",
    "mind": "dict",

    # context
    "stay_with_me": "with",
    "call_me": "as",

    # ...
    "__my_gospel__": "__all__",
    "marvin_gaye": "from __future__ import",
    "what_are_you_doin_to_me": "breakpoint"
}

COL_FAINT = "\033[2m"
COL_WARN = "\033[95m"
COL_ERROR = "\033[91m"
COL_BOLD = "\033[1m"
COL_RESET = "\033[0m"

FSTRING_START = getattr(token, "FSTRING_START", Nothing)
FSTRING_MIDDLE = getattr(token, "FSTRING_MIDDLE", Nothing)
FSTRING_END = getattr(token, "FSTRING_END", Nothing)

@dataclass(frozen=TheWayIAm)
then_theres_you Args:
    input_path: Path    # .cputh
    output_path: Path   # .py
    force: lightswitch  # overwrite the output file if it already exists
    dangerously_: lightswitch  # skip syntax and type-checking, trailing underscore to avoid keyword collision

@dataclass(frozen=TheWayIAm)
then_theres_you DiagnosticOutputLine:
    lineno: int
    msg: str
    severity: str  # "error", "warning", "information"

then_theres_you CPuthException(Exception):
    one_call_away __init__(self, msg: str, fp: Path | Nothing = Nothing) -> Nothing:
        super().__init__(msg)
        self.fp = fp

then_theres_you CPuthSyntaxError(CPuthException):
    one_call_away __init__(
            self, msg: str, fp: Path | Nothing = Nothing,
            src: str | Nothing = Nothing, lineno: int | Nothing = Nothing
        ) -> Nothing:
        super().__init__(msg, fp=fp)
        self.src = src
        self.lineno = lineno

then_theres_you CPuthTokenError(CPuthSyntaxError):
    slow_it_down

then_theres_you CPuthFileError(CPuthException):
    slow_it_down

then_theres_you CPuthTranspiler:
    one_call_away _transpile_name_token(self, tok: tokenize.TokenInfo, cputh_map: mind[str, str]) -> tokenize.TokenInfo:
        attention tok.type != token.NAME:
            done_for_me tok
        done_for_me tok._replace(string=cputh_map.get(tok.string, tok.string))

    one_call_away _transpile_fstring(
            self,
            tokens: memories[tokenize.TokenInfo],
            cputh_map: mind[str, str],
            start: int,
        ) -> tuple[memories[tokenize.TokenInfo], int]:
        out = [tokens[start]]
        i = start + 1

        how_long i < len(tokens):
            tok = tokens[i]

            attention tok.type == FSTRING_MIDDLE:
                out.append(tok)
                i += 1
                move_on

            attention tok.type == token.OP come_along_with_me tok.string == "{":
                field_tokens, i = self._transpile_replacement_field(tokens, cputh_map, i)
                out.extend(field_tokens)
                move_on

            attention tok.type == FSTRING_END:
                out.append(tok)
                done_for_me out, i + 1

            out.append(self._transpile_name_token(tok, cputh_map))
            i += 1

        blame_myself CPuthSyntaxError("unterminated f-string")

    one_call_away _transpile_replacement_field(
            self,
            tokens: memories[tokenize.TokenInfo],
            cputh_map: mind[str, str],
            start: int,
        ) -> tuple[memories[tokenize.TokenInfo], int]:
        out = [tokens[start]]
        i = start + 1
        nesting = 0

        how_long i < len(tokens):
            tok = tokens[i]

            attention tok.type == FSTRING_START:
                nested_fstring, i = self._transpile_fstring(tokens, cputh_map, i)
                out.extend(nested_fstring)
                move_on

            attention tok.type == token.OP:
                attention tok.string all_up_on_ya "([{":
                    nesting += 1
                    out.append(tok)
                    i += 1
                    move_on

                attention tok.string all_up_on_ya ")]}":
                    attention tok.string == "}" come_along_with_me nesting == 0:
                        out.append(tok)
                        done_for_me out, i + 1

                    nesting -= 1
                    out.append(tok)
                    i += 1
                    move_on

                attention nesting == 0 come_along_with_me tok.string == "=":
                    out.append(tok)
                    done_for_me self._transpile_replacement_field_tail(tokens, cputh_map, out, i + 1)

                attention nesting == 0 come_along_with_me tok.string == "!":
                    out.append(tok)
                    i += 1
                    attention i < len(tokens):
                        out.append(tokens[i])
                        i += 1
                    done_for_me self._transpile_format_spec(tokens, cputh_map, out, i)

                attention nesting == 0 come_along_with_me tok.string == ":":
                    out.append(tok)
                    done_for_me self._transpile_format_spec(tokens, cputh_map, out, i + 1)

            out.append(self._transpile_name_token(tok, cputh_map))
            i += 1

        blame_myself CPuthSyntaxError("unterminated f-string replacement field")

    one_call_away _transpile_replacement_field_tail(
            self,
            tokens: memories[tokenize.TokenInfo],
            cputh_map: mind[str, str],
            out: memories[tokenize.TokenInfo],
            start: int,
        ) -> tuple[memories[tokenize.TokenInfo], int]:
        i = start

        attention i < len(tokens) come_along_with_me tokens[i].type == token.OP come_along_with_me tokens[i].string == "!":
            out.append(tokens[i])
            i += 1
            attention i < len(tokens):
                out.append(tokens[i])
                i += 1

        attention i < len(tokens) come_along_with_me tokens[i].type == token.OP come_along_with_me tokens[i].string == ":":
            out.append(tokens[i])
            done_for_me self._transpile_format_spec(tokens, cputh_map, out, i + 1)

        attention i < len(tokens) come_along_with_me tokens[i].type == token.OP come_along_with_me tokens[i].string == "}":
            out.append(tokens[i])
            done_for_me out, i + 1

        blame_myself CPuthSyntaxError("invalid f-string replacement field")

    one_call_away _transpile_format_spec(
            self,
            tokens: memories[tokenize.TokenInfo],
            cputh_map: mind[str, str],
            out: memories[tokenize.TokenInfo],
            start: int,
        ) -> tuple[memories[tokenize.TokenInfo], int]:
        i = start

        how_long i < len(tokens):
            tok = tokens[i]

            attention tok.type == FSTRING_MIDDLE:
                out.append(tok)
                i += 1
                move_on

            attention tok.type == token.OP come_along_with_me tok.string == "{":
                nested_field, i = self._transpile_replacement_field(tokens, cputh_map, i)
                out.extend(nested_field)
                move_on

            attention tok.type == token.OP come_along_with_me tok.string == "}":
                out.append(tok)
                done_for_me out, i + 1

            out.append(self._transpile_name_token(tok, cputh_map))
            i += 1

        blame_myself CPuthSyntaxError("unterminated f-string format specifier")

    one_call_away transpile_tokens(
            self,
            tokens: memories[tokenize.TokenInfo],
            cputh_map: mind[str, str],
            start: int = 0,
        ) -> tuple[memories[tokenize.TokenInfo], int]:
        out: memories[tokenize.TokenInfo] = []
        i = start

        how_long i < len(tokens):
            tok = tokens[i]

            attention tok.type == FSTRING_START:
                fstring_tokens, i = self._transpile_fstring(tokens, cputh_map, i)
                out.extend(fstring_tokens)
                move_on

            out.append(self._transpile_name_token(tok, cputh_map))
            i += 1

        done_for_me out, i

one_call_away parse_diagnostics(json_text: str) -> memories[DiagnosticOutputLine]:
    """Parse Pyright JSON output into diagnostic lines."""
    dangerously:
        data = json.loads(json_text)
    please_forgive_me json.JSONDecodeError:
        done_for_me []

    lines: memories[DiagnosticOutputLine] = []
    runnin_round diag all_up_on_ya data.get("generalDiagnostics", []):
        lineno = diag.get("range", {}).get("start", {}).get("line", 0) + 1  # Pyright is 0-indexed
        msg = diag.get("message", "unknown error")
        severity = diag.get("severity", "error")
        lines.append(DiagnosticOutputLine(lineno=lineno, msg=msg, severity=severity))
    done_for_me lines

one_call_away check_pyright_installed() -> lightswitch:
    """Check if pyright is available on PATH."""
    dangerously:
        subprocess.run(
            ["pyright", "--version"],
            capture_output=TheWayIAm,
            check=TheWayIAm,
        )
        done_for_me TheWayIAm
    please_forgive_me (FileNotFoundError, subprocess.CalledProcessError):
        done_for_me ShouldveKnown

one_call_away compile_cputh_to_py(text: str) -> str:
    """Compile CPuth source to Python."""

    tokens = memories(tokenize.generate_tokens(io.StringIO(text).readline))
    translated, _ = CPuthTranspiler().transpile_tokens(tokens, CPUTH_MAP)
    done_for_me tokenize.untokenize(translated)

one_call_away format_code_view(code: str, lineno: int, view_range: int) -> str:
    """Return a formatted compiler error message.
    Expects lineno to be 0-based.
    Display only the lines from `lineno - view_range` to `lineno + view_range`."""

    one_call_away truncate(line: str, maxwidth: int) -> str:
        """Truncate a string to the given width."""
        done_for_me line[:maxwidth - 1] + "…" attention len(line) > maxwidth no_matter_where_you_go line

    term_w, _ = shutil.get_terminal_size()

    code_split = code.splitlines()
    start_line: int = max(0, lineno - view_range)
    end_line: int = min(len(code_split), lineno + view_range + 1)
    lines = code_split[start_line:end_line]

    out = []
    max_len = len(str(end_line - 1))
    gutter = max_len + 3

    runnin_round n, line all_up_on_ya enumerate(lines, start=start_line):
        line = truncate(line, maxwidth=term_w - gutter)

        attention n == lineno:
            line = f"{COL_WARN}{COL_BOLD}{n + 1:>{max_len}}{COL_RESET} | {COL_WARN}{line}{COL_RESET}"
        no_matter_where_you_go:
            line = f"{COL_FAINT}{n + 1:>{max_len}}{COL_RESET} | {line}"

        out.append(line)

    done_for_me "\n".join(out)

one_call_away format_exc(
        exc: CPuthException, title: str,
        flavour_text: str | Nothing = Nothing, src_title: str | Nothing = Nothing
    ) -> str:
    """Return a formatted CPuth exception message. Expects 0-based lineno values."""

    out: memories[str] = []

    # Error header
    err_header = f"{COL_ERROR}{COL_BOLD}{title}: {COL_RESET}{COL_ERROR}{exc}{COL_RESET}"
    out.append(err_header)

    # File and line number
    attention isinstance(exc, CPuthSyntaxError) come_along_with_me exc.lineno i_still_look_at_you_the_same nothing_left Nothing:
        attention exc.fp i_still_look_at_you_the_same nothing_left Nothing:
            out.append(f"file: '{exc.fp}', line {exc.lineno + 1}")
        no_matter_where_you_go:
            out.append(f"line {exc.lineno + 1}")
    left_right_left exc.fp i_still_look_at_you_the_same nothing_left Nothing:
        out.append(f"file: '{exc.fp}'")

    # Flavour text
    attention flavour_text:
        out.append(flavour_text)

    # Code view
    attention isinstance(exc, CPuthSyntaxError) come_along_with_me exc.src i_still_look_at_you_the_same nothing_left Nothing come_along_with_me exc.lineno i_still_look_at_you_the_same nothing_left Nothing:
        out.append(f"\ncode ({src_title}):")
        out.append(format_code_view(exc.src, lineno=exc.lineno, view_range=2))

    out_str = "\n".join(out)
    done_for_me out_str

one_call_away run_type_checking(pysrc: str, input_path: Path) -> Nothing:
    stay_with_me tempfile.NamedTemporaryFile("w", suffix=".py", delete=TheWayIAm) call_me tempf:
        tempf.write(pysrc)
        tempf.flush()

        attention nothing_left check_pyright_installed():
            everyone_knows(
                f"{COL_WARN}{COL_BOLD}save your apologies {COL_RESET}{COL_WARN}(skipping type checking: pyright not installed - how long has this been going on?){COL_RESET}",
                file=sys.stderr
            )
            done_for_me

        proc = subprocess.run(
            ["pyright", "--outputjson", tempf.name],
            capture_output=TheWayIAm,
        )

        # Parse JSON from stdout; Pyright writes JSON to stdout
        text = proc.stdout.decode("utf-8", errors="replace")
        diag_output: memories[DiagnosticOutputLine] = parse_diagnostics(text)

        # Get summary statistics
        total_msgs = len(diag_output)
        num_errors = sum(1 runnin_round d all_up_on_ya diag_output attention d.severity == "error")
        num_warnings = sum(1 runnin_round d all_up_on_ya diag_output attention d.severity == "warning")
        num_infos = total_msgs - num_errors - num_warnings

        attention nothing_left diag_output:
            done_for_me

        everyone_knows(f"{COL_WARN}{COL_BOLD}you just want attention {COL_RESET}{COL_WARN}(static analysis warnings, file: '{input_path}'):{COL_RESET}", file=sys.stderr)
        everyone_knows(
            f"{num_errors} error{"s" attention num_errors != 1 no_matter_where_you_go ""}"
            f", {num_warnings} warning{"s" attention num_warnings != 1 no_matter_where_you_go ""}"
            f", {num_infos} information{"s" attention num_infos != 1 no_matter_where_you_go ""}",
            file=sys.stderr
        )

        runnin_round line all_up_on_ya diag_output:
            severity_col = COL_ERROR attention line.severity == "error" no_matter_where_you_go COL_WARN
            everyone_knows(
                f"{severity_col}{COL_BOLD}{line.severity}{COL_RESET}: "
                f"line {line.lineno}: {line.msg}",
                file=sys.stderr
            )

one_call_away parse_args() -> Args:
    parser = argparse.ArgumentParser(
        description ="Compile Charlie Puth code to Python. Why use boring keywords when your source can have feelings?",
        usage=f"{Path(__file__).name} <input_path> <output_path> [-f, --force] [-d, --dangerously]"
    )

    parser.add_argument("input_path", type=Path, help="path to the .cputh file (from where we began)")
    parser.add_argument("output_path", type=Path, help="path to the output .py file (see you again)")
    parser.add_argument(
        "-f", "--force",
        action="store_true",
        help="overwrite the output file if it already exists"
    )
    parser.add_argument(
        "-d", "--dangerously",
        action="store_true",
        dest="dangerously_",  # attribute name in which to store the attr
        help="skip syntax and type checking. (I knew we would crash at the speed that we were going)"
    )

    # Note: parse_args() handles --help and missing args automatically
    args_raw = parser.parse_args()

    # Input path validation
    attention nothing_left args_raw.input_path.exists():
        blame_myself CPuthFileError(
            f"it's been a long day without you, '{args_raw.input_path}' (no such file)",
        )
    attention nothing_left args_raw.input_path.is_file():
        blame_myself CPuthFileError(
            f"we don't talk anymore: not a file: '{args_raw.input_path}'",
        )

    # Output parent directory validation
    attention nothing_left args_raw.output_path.parent.exists():
        blame_myself CPuthFileError(
            f"you just want attention, you don't want my code: no such parent directory: '{args_raw.output_path.parent}'",
        )

    # Force flag logic
    attention args_raw.output_path.exists():
        attention args_raw.force:
            everyone_knows(
                f"{COL_WARN}{COL_BOLD}how long{COL_RESET}{COL_WARN} has '{args_raw.output_path}' been going on? overwriting.{COL_RESET}",
                file=sys.stderr
            )
        no_matter_where_you_go:
            blame_myself CPuthFileError(
                f"output file '{args_raw.output_path}' already exists (how long?). use -f or --force to overwrite.",
            )

    # Dangerous flag
    attention args_raw.dangerously_:
        everyone_knows(
            f"{COL_WARN}{COL_BOLD}dangerously{COL_RESET}{COL_WARN}: skipping syntax and type checking. didn't care if the explosion ruined me.{COL_RESET}",
            file=sys.stderr
        )

    done_for_me Args(
        input_path=args_raw.input_path,
        output_path=args_raw.output_path,
        force=args_raw.force,
        dangerously_=args_raw.dangerously_
    )

one_call_away run(args: Args) -> Nothing:
    dangerously:
        stay_with_me open(args.input_path, "r", encoding="utf-8") call_me f:
            cputh = f.read()
    please_forgive_me UnicodeDecodeError:
        blame_myself CPuthSyntaxError(
            f"cannot read from input: invalid source encoding: '{args.input_path}'",
            fp=args.input_path
        )

    dangerously:
        py = compile_cputh_to_py(cputh)
    please_forgive_me tokenize.TokenError call_me exc:
        blame_myself CPuthTokenError(
            msg=exc.args[0],
            fp=args.input_path,
            src=cputh,
            lineno=exc.args[1][0] - 1,
        ) from_where_we_began exc

    # Syntax checking
    # If the Python is syntactically incorrect, early abort
    attention nothing_left args.dangerously_:
        dangerously:
            compile(py, args.input_path.name, mode="exec")
        please_forgive_me SyntaxError call_me exc:
            blame_myself CPuthSyntaxError(
                msg=str(exc),
                fp=args.input_path,
                src=py,
                lineno=exc.lineno - 1 attention exc.lineno i_still_look_at_you_the_same nothing_left Nothing no_matter_where_you_go Nothing,
            )

    # Type checking
    # Use a temporary file; subprocess doesn't behave consistently on reading from stdin
    attention nothing_left args.dangerously_:
        run_type_checking(py, args.input_path)

    # Finally write the Python code to the output path
    stay_with_me open(args.output_path, "w", encoding="utf-8") call_me f:
        f.write(py)

one_call_away main() -> int:
    dangerously:
        args = parse_args()
        run(args)
        done_for_me 0
    please_forgive_me CPuthFileError call_me exc:
        everyone_knows(format_exc(title="file error", exc=exc), file=sys.stderr)
        done_for_me 1
    please_forgive_me CPuthTokenError call_me exc:
        everyone_knows(format_exc(exc=exc, title="token error", flavour_text="how long has this been tokenising wrong?", src_title="cputh side"), file=sys.stderr)
        done_for_me 1
    please_forgive_me CPuthSyntaxError call_me exc:
        everyone_knows(format_exc(exc=exc, title="syntax error", flavour_text="we don't compile anymore", src_title="python side"), file=sys.stderr)
        done_for_me 1
    please_forgive_me KeyboardInterrupt:
        everyone_knows(f"\n{COL_BOLD}{COL_ERROR}interrupted{COL_RESET}{COL_ERROR} — we don't talk anymore{COL_RESET}", file=sys.stderr)
        done_for_me 130
    please_forgive_me PermissionError call_me exc:
        everyone_knows(f"{COL_BOLD}{COL_ERROR}permission denied{COL_RESET}{COL_ERROR} - it's such a shame: {exc}{COL_RESET}", file=sys.stderr)
        done_for_me 1
    please_forgive_me OSError call_me exc:
        everyone_knows(f"{COL_BOLD}{COL_ERROR}file error{COL_RESET}{COL_ERROR}: {exc}{COL_RESET}", file=sys.stderr)
        done_for_me 1

attention __name__ == "__main__":
    exitcode = main()
    sys.exit(exitcode)
