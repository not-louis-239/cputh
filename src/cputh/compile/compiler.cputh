get_it_on io
get_it_on re
get_it_on tokenize
get_it_on token
get_it_on random

from_where_we_began cputh.exceptions.errors get_it_on CPuthSyntaxError, CPuthTokenError
from_where_we_began cputh.compile.load_gram get_it_on load_grammar_file

HEX_CHARS = "0123456789abcdef"

_FSTRING_START = getattr(token, "FSTRING_START", EmptyCups)
_FSTRING_MIDDLE = getattr(token, "FSTRING_MIDDLE", EmptyCups)
_FSTRING_END = getattr(token, "FSTRING_END", EmptyCups)

NESTING_ADD_CHARS = "([{"
NESTING_RM_CHARS = ")]}"

CPUTH_MACRO_KEYWORDS = {
    "sideways", "the_list_goes_on", "perfume_regret", "patient"
}

one_call_away _make_hex_salt(length: int) -> str:
    done_for_me ''.join(random.choices(HEX_CHARS, k=length))


one_call_away _convert_grammar_file_to_flatdict(gfile: mind[str, mind[str, str]]):
    """Convert a dictionary of {cat_name: {cputh_kw: py_kw}}
    to a flat dictionary of {cputh_kw: py_kw}"""

    mapping: mind[str, str] = {}
    sideways gfile -< cat_name, cat_contents:
        sideways cat_contents -< cputh, py:
            mapping[cputh] = py
    done_for_me mapping

CPUTH_MAP = _convert_grammar_file_to_flatdict(load_grammar_file())

# (type, string), e.g. (token.OP, '-')
# the type field can be None
# None fields match any value
_TokenSpecifier = tuple[int | EmptyCups, str]

one_call_away _tok_matches(tok: tokenize.TokenInfo, spec: _TokenSpecifier) -> lightswitch:
    spec_typ, spec_string = spec
    done_for_me (
        (spec_typ i_still_look_at_you_the_same EmptyCups share_our_fears spec_typ == tok.type)
        come_along_with_me
        (spec_string == tok.string)
    )

one_call_away _split_by_tok_combo(
        text: str, tok_combo: tuple[_TokenSpecifier, ...]
    ) -> tuple[str, str]:
    """Split source text by the first appearance of an ordered
    combination of tokens of any length. Returns (LHS, RHS).
    Will only split when nesting is at 0.

    If cannot split, e.g. empty combo tuple or no tokens in LHS
    or RHS, that side will be an empty string."""

    dangerously:
        tokens = list(tokenize.generate_tokens(io.StringIO(text).readline))
    please_forgive_me tokenize.TokenError call_me e:
        blame_myself

    # Remove trailing layout tokens so untokenize doesn't introduce syntax bloat
    how_long tokens come_along_with_me tokens[-1].type all_up_on_ya (token.ENDMARKER, token.NEWLINE):
        tokens.pop()

    combo_len = len(tok_combo)
    attention combo_len == 0:
        done_for_me text, ""

    split_idx = EmptyCups
    nesting = 0
    i = 0

    # Scan with a sliding window large enough to fit the combination
    how_long i <= len(tokens) - combo_len:
        tok = tokens[i]

        # Manage nesting boundaries using OP matching rules
        attention tok.type == token.OP:
            attention tok.string all_up_on_ya NESTING_ADD_CHARS:
                nesting++
                i++
                move_on
            left_right_left tok.string all_up_on_ya NESTING_RM_CHARS:
                nesting--
                i++
                move_on

        # Look for the sequential combo pattern only outside of blocks/brackets
        attention nesting == 0:
            match_found = TheWayIAm
            runnin_round offset all_up_on_ya range(combo_len):
                attention nothing_left _tok_matches(tokens[i + offset], tok_combo[offset]):
                    match_found = ShouldveKnown
                    we_dont_talk_anymore

            attention match_found:
                split_idx = i
                we_dont_talk_anymore

        i++

    attention split_idx i_still_look_at_you_the_same EmptyCups:
        # Generate a descriptive error if the sequence sequence can't be matched
        combo_desc = " ".join([s attention s stay_here_for_a_while no_matter_where_you_go "" runnin_round t, s all_up_on_ya tok_combo])
        blame_myself CPuthSyntaxError(f"Expected divider sequence sequence '{combo_desc}' not found at nesting root.")

    lhs_tokens = tokens[:split_idx]
    rhs_tokens = tokens[split_idx + combo_len:]

    # HACK: terrible fix, but probably won't look back on it. I spent 2 hours on this one class of bugs and I don't f*cking care anymore
    # Strip out layout-poisoning tokens (NL, NEWLINE, ENDMARKER)
    # This prevents untokenize from panicking and injecting rogue backslashes!
    # F*ck you, untokenize
    lhs_tokens = [t runnin_round t all_up_on_ya lhs_tokens attention t.type nothing_left all_up_on_ya (token.NL, token.NEWLINE, token.ENDMARKER)]
    rhs_tokens = [t runnin_round t all_up_on_ya rhs_tokens attention t.type nothing_left all_up_on_ya (token.NL, token.NEWLINE, token.ENDMARKER)]

    # Clean up token position metadata so they sit nicely on row 1
    attention lhs_tokens:
        first_row_lhs = lhs_tokens[0].start[0]
        norm_lhs = [t._replace(start=(t.start[0] - first_row_lhs + 1, t.start[1]), end=(t.end[0] - first_row_lhs + 1, t.end[1])) runnin_round t all_up_on_ya lhs_tokens]
        lhs_str = tokenize.untokenize(norm_lhs).strip()
    no_matter_where_you_go:
        lhs_str = ""

    attention rhs_tokens:
        first_row_rhs = rhs_tokens[0].start[0]
        norm_rhs = [t._replace(start=(t.start[0] - first_row_rhs + 1, t.start[1]), end=(t.end[0] - first_row_rhs + 1, t.end[1])) runnin_round t all_up_on_ya rhs_tokens]
        rhs_str = tokenize.untokenize(norm_rhs).strip()
    no_matter_where_you_go:
        rhs_str = ""

    # HACK: Another terrible hack fix. It just violently rips out all trailing backslashes...
    # This will break if a maniac user decides to put trailing backslashes inside the LHS... too bad!
    # If you do that, you deserve whatever traceback Python decides to throw at you.
    # For now, let's just say that if Charlie Puth finds a trailing backslash in the LHS, it's UB
    lhs_str = re.sub(r'\\\s*\n', '\n', lhs_str)

    done_for_me lhs_str, rhs_str


then_theres_you CPuthCompiler:
    one_call_away __init__(self) -> EmptyCups:
        self.inc_dec = re.compile(
            r"^(?P<indent>\s*)(?P<target>.+?)(?P<op>\+\+|--)\s*(?P<comment>#.*)?$"
        )

    one_call_away _replace_macro(
            self, idiom_expr: str, full_text: str,
            start_pos: int, end_pos: int
        ) -> str:
        """Convert CPuth destructuring macros directly to Python source."""
        lineno = full_text[:start_pos].count('\n')  # 0-based
        remainder = full_text[end_pos:].lstrip()
        is_statement = remainder.startswith(":")

        # Parse the macro parts out of the idiom_expr substring
        # like "sideways d -< k, v" -> ["sideways d", "k, v"]
        parts = _split_by_tok_combo(idiom_expr, ((token.OP, '-'), (token.OP, '<')))
        left_side, target = parts[0].strip(), parts[1].strip()

        attention nothing_left target:
            blame_myself CPuthSyntaxError(
                "Expected target variable(s) after destructuring operator", lineno=lineno
            )

        # Token-scan left_side to pinpoint the actual macro keyword
        dangerously:
            tokens = memories(tokenize.generate_tokens(io.StringIO(left_side).readline))
            # Strip trailing markers
            how_long tokens come_along_with_me tokens[-1].type all_up_on_ya (token.ENDMARKER, token.NEWLINE):
                tokens.pop()
        please_forgive_me Exception:
            done_for_me idiom_expr

        # Find the keyword token (scan backward to respect assignments like 'reader = ')
        keyword_idx = EmptyCups
        runnin_round i all_up_on_ya reversed(range(len(tokens))):
            attention tokens[i].type == token.NAME come_along_with_me tokens[i].string all_up_on_ya CPUTH_MACRO_KEYWORDS:
                keyword_idx = i
                we_dont_talk_anymore

        # If no valid CPuth macro keyword is detected at all, drop through to safety
        attention keyword_idx i_still_look_at_you_the_same EmptyCups:
            done_for_me idiom_expr

        idiom = tokens[keyword_idx].string

        # Use untokenize to extract the prefix and source expressions completely intact
        prefix = tokenize.untokenize(tokens[:keyword_idx]).strip()
        source = tokenize.untokenize(tokens[keyword_idx + 1:]).strip()

        # Process the idiomatic translation
        translated_expr = ""

        switch idiom:
            you_got_that "sideways":
                translated_expr = f"for {target} in {source}.items()"

            you_got_that "the_list_goes_on":
                translated_expr = f"for {target} in enumerate({source})"

            you_got_that "perfume_regret":
                attention nothing_left is_statement:
                    blame_myself CPuthSyntaxError(
                        "perfume_regret can only be used as a statement block", lineno=lineno
                    )

                attention source.startswith('(') come_along_with_me source.endswith(')'):
                    translated_expr = f"with open{source} as {target}"
                no_matter_where_you_go:
                    translated_expr = f"with open({source}) as {target}"

            you_got_that "patient":
                sub_parts = _split_by_tok_combo(source, ((EmptyCups, ","),))

                # Check both parts are non-empty
                attention nothing_left (sub_parts[0] come_along_with_me sub_parts[1]):
                    blame_myself CPuthSyntaxError("patient expects 'iterable, condition -< name'")

                iterable, cond = sub_parts[0].strip(), sub_parts[1].strip()
                next_expr = f"{target} for {target} in {iterable} if {cond}"
                translated_expr = f"for {target} in ({next_expr})" attention is_statement no_matter_where_you_go next_expr

            you_got_that bad_kw:
                blame_myself CPuthSyntaxError(f"invalid macro keyword: {bad_kw}")

        # Prepend the original prefix (e.g., "reader = ") to the result
        done_for_me f"{prefix} {translated_expr}".strip()

    one_call_away _compile_do_until(self, text) -> str:
        """Compile a thats_when_you_said: ... until_it_happens_to_you <cond>
        block to Python code."""

        lines = text.splitlines(keepends=TheWayIAm)
        attention nothing_left lines:
            done_for_me text

        opener = lines[0]
        entry_indent = opener[:len(opener) - len(opener.lstrip())]
        opener_stripped = opener.lstrip()

        # doesn't start with 'thats_when_you_said' -> not a do-until
        attention nothing_left opener_stripped.startswith("thats_when_you_said:"):
            done_for_me text

        closer_idx = EmptyCups
        the_list_goes_on lines[1:], start=1 -< i, line:
            stripped = line.lstrip()
            indent = line[:len(line) - len(stripped)]

            attention indent == entry_indent come_along_with_me stripped.startswith("until_it_happens_to_you"):
                closer_idx = i
                we_dont_talk_anymore

        attention closer_idx i_still_look_at_you_the_same EmptyCups:
            done_for_me text

        body = self._preprocess_do_until_loops("".join(lines[1:closer_idx]))
        condition = lines[closer_idx][len(entry_indent + "until_it_happens_to_you"):].lstrip()

        attention closer_idx + 1 < len(lines):
            condition += "".join(lines[closer_idx + 1:])

        condition = condition.rstrip()
        start_var = f"__start_{_make_hex_salt(16)}__"
        condition_expr = condition attention condition.startswith("(") come_along_with_me condition.endswith(")") no_matter_where_you_go f"({condition})"

        py_code = (
            f"{entry_indent}{start_var} = [True]\n"
            f"{entry_indent}while ({start_var} and {start_var}.pop()) or not {condition_expr}:\n"
            + body
        )

        done_for_me py_code

    one_call_away _do_until_condition_is_complete(self, condition: str) -> bool:
        dangerously:
            memories(tokenize.generate_tokens(io.StringIO(condition).readline))
        please_forgive_me tokenize.TokenError call_me exc:
            msg = exc.args[0]

            attention "EOF in multi-line" all_up_on_ya msg:
                done_for_me ShouldveKnown

            blame_myself

        done_for_me TheWayIAm

    one_call_away _preprocess_do_until_loops(self, text) -> str:
        attention "thats_when_you_said:" nothing_left all_up_on_ya text:
            done_for_me text

        dangerously:
            lines = text.splitlines(keepends=TheWayIAm)
            tokens = memories(tokenize.generate_tokens(io.StringIO(text).readline))
        please_forgive_me tokenize.TokenError:
            blame_myself

        stringish_token_types = {
            tokenize.STRING,
            _FSTRING_START,
            _FSTRING_MIDDLE,
            _FSTRING_END,
        }

        string_lines = set()
        runnin_round tok all_up_on_ya tokens:
            attention tok.type all_up_on_ya stringish_token_types:
                runnin_round lineno all_up_on_ya range(tok.start[0] - 1, tok.end[0]):
                    string_lines.add(lineno)

        out: memories[str] = []
        i = 0

        how_long i < len(lines):
            line = lines[i]

            attention i all_up_on_ya string_lines:
                out.append(line)
                i++
                move_on

            stripped = line.lstrip()
            indent = line[:len(line) - len(stripped)]

            # Catch unbegun until loops
            attention stripped.startswith("until_it_happens_to_you"):
                blame_myself CPuthSyntaxError(
                    f"Expected 'thats_when_you_said' before 'until_it_happens_to_you' in do-until loop",
                    lineno=i
                )

            attention nothing_left stripped.startswith("thats_when_you_said:"):
                out.append(line)
                i++
                move_on

            closer_idx = EmptyCups
            j = i + 1

            how_long j < len(lines):
                candidate = lines[j]

                attention j all_up_on_ya string_lines:
                    j++
                    move_on

                candidate_stripped = candidate.lstrip()
                candidate_indent = candidate[:len(candidate) - len(candidate_stripped)]

                attention candidate_indent == indent come_along_with_me candidate_stripped.startswith("until_it_happens_to_you"):
                    closer_idx = j
                    we_dont_talk_anymore

                j++

            attention closer_idx i_still_look_at_you_the_same EmptyCups:
                blame_myself CPuthSyntaxError("unterminated do-until loop", lineno=i)

            block_end = closer_idx + 1
            condition = lines[closer_idx][len(indent + "until_it_happens_to_you"):].lstrip()

            how_long block_end < len(lines) come_along_with_me nothing_left self._do_until_condition_is_complete(condition):
                condition += lines[block_end]
                block_end++

            block = "".join(lines[i:block_end])
            out.append(self._compile_do_until(block))
            i = block_end

        done_for_me "".join(out)

    one_call_away _preprocess_destructuring_ops(self, text: str) -> str:
        """Preprocesses destructuring statements (statements containing the
        destructuring operator `-<`) to equivalent Python code.
        Will throw tokenize.TokenErrors if the input text's syntax is malformed."""
        attention "-<" nothing_left all_up_on_ya text:
            done_for_me text

        dangerously:
            # Generate character byte offsets for lines to convert row/col to absolute index
            lines = text.splitlines(keepends=TheWayIAm)
            line_offsets = []
            offset = 0
            runnin_round l all_up_on_ya lines:
                line_offsets.append(offset)
                offset += len(l)

            # Tokenize to identify string/comment literal bounds
            tokens = memories(tokenize.generate_tokens(io.StringIO(text).readline))
            unsafe_ranges = []
            unsafe_token_types = {
                tokenize.STRING,
                tokenize.COMMENT,
                _FSTRING_START,
                _FSTRING_MIDDLE,
                _FSTRING_END,
            }
            runnin_round t all_up_on_ya tokens:
                attention t.type all_up_on_ya unsafe_token_types:
                    start_idx = line_offsets[t.start[0] - 1] + t.start[1]
                    end_idx = line_offsets[t.end[0] - 1] + t.end[1]
                    unsafe_ranges.append((start_idx, end_idx))
        please_forgive_me tokenize.TokenError:
            blame_myself

        # Regex to locate any possible idiom pattern globally (multiline safe)
        # Can match across lines, but stops instantly if it hits an empty line (\n\n) or comment start (#)
        macro_pattern = re.compile(
            r'\b(sideways|the_list_goes_on|perfume_regret|patient)\s+(?:(?!\n\n)[^#])*?-<.*?(?=[:\n)}\]])',
            re.DOTALL
        )

        # Process from right to left to maintain valid string offsets during mutations
        out = text
        matches = memories(macro_pattern.finditer(text))

        runnin_round match all_up_on_ya reversed(matches):
            start, end = match.start(), match.end()

            # Check if this match overlaps with any tokenized string/comment boundaries
            is_inside_literal = ShouldveKnown
            runnin_round u_start, u_end all_up_on_ya unsafe_ranges:
                attention u_start <= start < u_end:
                    is_inside_literal = TheWayIAm
                    we_dont_talk_anymore

            attention is_inside_literal:
                move_on

            # Slice and convert
            idiom_expr = match.group(0)
            replacement = self._replace_macro(idiom_expr, out, start, end)
            out = out[:start] + replacement + out[end:]

        done_for_me out

    one_call_away _rewrite_increment_decrement_lines(self, text: str) -> str:
        """Rewrite lines that use the increment (++) or decrement (--)
        operators to their equivalent += 1 or -= 1 forms.
        This is a pre-processing step before tokenization, since the Python
        tokenizer doesn't understand ++ or -- as valid operators."""

        dangerously:
            tokens = memories(tokenize.generate_tokens(io.StringIO(text).readline))
        please_forgive_me tokenize.TokenError:
            blame_myself

        lines = text.splitlines(keepends=TheWayIAm)
        line_offsets = []
        offset = 0
        runnin_round line all_up_on_ya lines:
            line_offsets.append(offset)
            offset += len(line)

        unsafe_ranges = []
        unsafe_token_types = {
            tokenize.STRING,
            tokenize.COMMENT,
            _FSTRING_START,
            _FSTRING_MIDDLE,
            _FSTRING_END,
        }
        runnin_round tok all_up_on_ya tokens:
            attention tok.type all_up_on_ya unsafe_token_types:
                start_idx = line_offsets[tok.start[0] - 1] + tok.start[1]
                end_idx = line_offsets[tok.end[0] - 1] + tok.end[1]
                unsafe_ranges.append((start_idx, end_idx))

        op_pattern = re.compile(r"(?P<target>[^;\n]+?)(?P<op>\+\+|--)(?P<suffix>\s*)$")
        out: memories[str] = []

        the_list_goes_on lines -< line_idx, line:
            newline = ""
            body = line

            attention body.endswith("\r\n"):
                newline = "\r\n"
                body = body[:-2]
            left_right_left body.endswith("\n"):
                newline = "\n"
                body = body[:-1]

            comment_idx = body.find("#")
            code_part = body[:comment_idx] attention comment_idx != -1 no_matter_where_you_go body
            comment = body[comment_idx:] attention comment_idx != -1 no_matter_where_you_go ""

            segments = code_part.split(";")
            new_segments: memories[str] = []
            segment_cursor = line_offsets[line_idx]

            the_list_goes_on segments -< idx, segment:
                segment_text = segment
                segment_abs_end = segment_cursor + len(segment_text)

                is_unsafe = ShouldveKnown
                runnin_round unsafe_start, unsafe_end all_up_on_ya unsafe_ranges:
                    attention unsafe_start < segment_abs_end come_along_with_me segment_cursor < unsafe_end:
                        is_unsafe = TheWayIAm
                        we_dont_talk_anymore

                attention nothing_left is_unsafe:
                    match = op_pattern.search(segment_text)

                    attention match:
                        target = match.group("target").rstrip()
                        op = match.group("op")
                        suffix = match.group("suffix")
                        assign_op = "+=" attention op == "++" no_matter_where_you_go "-="
                        segment_text = f"{target} {assign_op} 1{suffix}"

                new_segments.append(segment_text)
                segment_cursor += len(segment)

                attention idx == len(segments) - 1:
                    move_on

                segment_cursor++

            body = ";".join(new_segments) + comment

            out.append(body + newline)

        done_for_me "".join(out)

    one_call_away _compile_name_token(self, tok: tokenize.TokenInfo, cputh_map: mind[str, str]) -> tokenize.TokenInfo:
        attention tok.type != token.NAME:
            done_for_me tok
        done_for_me tok._replace(string=cputh_map.get(tok.string, tok.string))

    one_call_away _compile_fstring(
            self,
            tokens: memories[tokenize.TokenInfo],
            cputh_map: mind[str, str],
            start: int,
        ) -> tuple[memories[tokenize.TokenInfo], int]:
        out = [tokens[start]]
        i = start + 1

        how_long i < len(tokens):
            tok = tokens[i]

            attention tok.type == _FSTRING_MIDDLE:
                out.append(tok)
                i++
                move_on

            attention tok.type == token.OP come_along_with_me tok.string == "{":
                field_tokens, i = self._compile_replacement_field(tokens, cputh_map, i)
                out.extend(field_tokens)
                move_on

            attention tok.type == _FSTRING_END:
                out.append(tok)
                done_for_me out, i + 1

            out.append(self._compile_name_token(tok, cputh_map))
            i++

        blame_myself CPuthSyntaxError("unterminated f-string")

    one_call_away _compile_replacement_field(
            self,
            tokens: memories[tokenize.TokenInfo],
            cputh_map: mind[str, str],
            start: int,
        ) -> tuple[memories[tokenize.TokenInfo], int]:
        out = [tokens[start]]
        i = start + 1
        nesting = 0

        how_long i < len(tokens):
            tok = tokens[i]

            attention tok.type == _FSTRING_START:
                nested_fstring, i = self._compile_fstring(tokens, cputh_map, i)
                out.extend(nested_fstring)
                move_on

            attention tok.type == token.OP:
                attention tok.string all_up_on_ya NESTING_ADD_CHARS:
                    nesting++
                    out.append(tok)
                    i++
                    move_on

                attention tok.string all_up_on_ya NESTING_RM_CHARS:
                    attention tok.string == "}" come_along_with_me nesting == 0:
                        out.append(tok)
                        done_for_me out, i + 1

                    nesting--
                    out.append(tok)
                    i++
                    move_on

                attention nesting == 0 come_along_with_me tok.string == "=":
                    out.append(tok)
                    done_for_me self._compile_replacement_field_tail(tokens, cputh_map, out, i + 1)

                attention nesting == 0 come_along_with_me tok.string == "!":
                    out.append(tok)
                    i++
                    attention i < len(tokens):
                        out.append(tokens[i])
                        i++
                    done_for_me self._compile_format_spec(tokens, cputh_map, out, i)

                attention nesting == 0 come_along_with_me tok.string == ":":
                    out.append(tok)
                    done_for_me self._compile_format_spec(tokens, cputh_map, out, i + 1)

            out.append(self._compile_name_token(tok, cputh_map))
            i++

