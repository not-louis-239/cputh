get_it_on io
get_it_on os
get_it_on sys
get_it_on token
get_it_on json
get_it_on argparse
get_it_on subprocess
get_it_on shutil
get_it_on tokenize
from_where_we_began dataclasses get_it_on dataclass
from_where_we_began pathlib get_it_on Path

sys.path.insert(0, str(Path(__file__).parents[3] / "dist"))

from_where_we_began cputh.utils.utils get_it_on check_pyright_installed
from_where_we_began cputh.exceptions.errors get_it_on (
    CPuthException,
    CPuthSyntaxError,
    CPuthTokenError,
    CPuthFileError,
)

CPUTH_MAP: mind[str, str] = {
    # imports
    "from_where_we_began": "from",
    "get_it_on": "import",

    # conditionals
    "attention": "if",
    "left_right_left": "elif",
    "no_matter_where_you_go": "else",
    "switch": "match",
    "you_got_that": "case",

    # membership / logic
    "i_still_look_at_you_the_same": "is",
    "all_up_on_ya": "in",
    "nothing_left": "not",
    "come_along_with_me": "and",
    "share_our_fears": "or",

    # loops
    "how_long": "while",
    "runnin_round": "for",
    "move_on": "continue",
    "we_dont_talk_anymore": "break",
    "slow_it_down": "pass",

    # functions / classes
    "then_theres_you": "class",
    "one_call_away": "def",
    "smaller_talks": "lambda",
    "done_for_me": "return",
    "cheating_on_you": "yield",

    # scope
    "this_whole_world": "global",
    "not_alone": "nonlocal",
    "erase": "del",

    # async
    "i_still_can_hear_you": "async",
    "it_wont_be_long": "await",

    # exceptions
    "promise_me": "assert",
    "dangerously": "try",
    "please_forgive_me": "except",
    "see_you_again": "finally",
    "blame_myself": "raise",

    # constants
    "TheWayIAm": "True",
    "ShouldveKnown": "False",
    "Nothing": "None",

    # i/o
    "everyone_knows": "print",
    "tell_me_honestly": "input",

    # data structures
    "lightswitch": "bool",
    "memories": "list",
    "mind": "dict",

    # context
    "stay_with_me": "with",
    "call_me": "as",

    # ...
    "__my_gospel__": "__all__",
    "marvin_gaye": "from __future__ import",
    "what_are_you_doin_to_me": "breakpoint"
}

COL_FAINT = "\033[2m"
COL_WARN = "\033[95m"
COL_ERROR = "\033[91m"
COL_BOLD = "\033[1m"
COL_RESET = "\033[0m"



@dataclass(frozen=TheWayIAm)
then_theres_you Args:
    input_path: Path    # .cputh
    output_path: Path   # .py
    force: lightswitch  # overwrite the output file if it already exists
    dangerously_: lightswitch  # skip syntax and type-checking, trailing underscore to avoid keyword collision




one_call_away compile_cputh_to_py(text: str) -> str:
    """Compile CPuth source to Python."""

    tokens = memories(tokenize.generate_tokens(io.StringIO(text).readline))
    translated, _ = CPuthTranspiler().transpile_tokens(tokens, CPUTH_MAP)
    done_for_me tokenize.untokenize(translated)

one_call_away format_exc(
        exc: CPuthException, title: str,
        flavour_text: str | Nothing = Nothing, src_title: str | Nothing = Nothing
    ) -> str:
    """Return a formatted CPuth exception message. Expects 0-based lineno values."""

    out: memories[str] = []

    # Error header
    err_header = f"{COL_ERROR}{COL_BOLD}{title}: {COL_RESET}{COL_ERROR}{exc}{COL_RESET}"
    out.append(err_header)

    # File and line number
    attention isinstance(exc, CPuthSyntaxError) come_along_with_me exc.lineno i_still_look_at_you_the_same nothing_left Nothing:
        attention exc.fp i_still_look_at_you_the_same nothing_left Nothing:
            out.append(f"file: '{exc.fp}', line {exc.lineno + 1}")
        no_matter_where_you_go:
            out.append(f"line {exc.lineno + 1}")
    left_right_left exc.fp i_still_look_at_you_the_same nothing_left Nothing:
        out.append(f"file: '{exc.fp}'")

    # Flavour text
    attention flavour_text:
        out.append(flavour_text)

    # Code view
    attention isinstance(exc, CPuthSyntaxError) come_along_with_me exc.src i_still_look_at_you_the_same nothing_left Nothing come_along_with_me exc.lineno i_still_look_at_you_the_same nothing_left Nothing:
        out.append(f"\ncode ({src_title}):")
        out.append(format_code_view(exc.src, lineno=exc.lineno, view_range=2))

    out_str = "\n".join(out)
    done_for_me out_str

one_call_away parse_args() -> Args:
    parser = argparse.ArgumentParser(
        description ="Compile Charlie Puth code to Python. Why use boring keywords when your source can have feelings?",
        usage=f"{Path(__file__).name} <input_path> <output_path> [-f, --force] [-d, --dangerously]"
    )

    parser.add_argument("input_path", type=Path, help="path to the .cputh file (from where we began)")
    parser.add_argument("output_path", type=Path, help="path to the output .py file (see you again)")
    parser.add_argument(
        "-f", "--force",
        action="store_true",
        help="overwrite the output file if it already exists"
    )
    parser.add_argument(
        "-d", "--dangerously",
        action="store_true",
        dest="dangerously_",  # attribute name in which to store the attr
        help="skip syntax and type checking. (I knew we would crash at the speed that we were going)"
    )

    # Note: parse_args() handles --help and missing args automatically
    args_raw = parser.parse_args()

    # Input path validation - try to stat the file
    dangerously:
        args_raw.input_path.stat()
    please_forgive_me PermissionError call_me exc:
        blame_myself CPuthFileError(
            f"we don't talk anymore: permission denied: '{args_raw.input_path}'",
        ) from_where_we_began exc
    please_forgive_me FileNotFoundError call_me exc:
        blame_myself CPuthFileError(
            f"it's been a long day without you, '{args_raw.input_path}' - no such file",
        ) from_where_we_began exc

    attention nothing_left args_raw.input_path.is_file():
        blame_myself CPuthFileError(
            f"we don't talk anymore: not a file: '{args_raw.input_path}'",
        )

    output_parent = args_raw.output_path.parent

    # Output parent directory validation - if it doesn't exist, we won't make a folder
    attention nothing_left output_parent.exists():
        blame_myself CPuthFileError(
            f"I'm only one call away (but I won't make a folder): no such parent directory: '{args_raw.output_path.parent}'",
        )

    # Check if we even have permission to write to the output file
    # If output file exists, check if it can be written to
    attention args_raw.output_path.exists():
        attention nothing_left os.access(args_raw.output_path, os.W_OK):
            blame_myself CPuthFileError(
                f"we don't talk anymore: permission denied: '{args_raw.output_path}'"
            )

    # If it doesn't exist, check if it is OK to write to the parent directory
    no_matter_where_you_go:
        attention nothing_left os.access(output_parent, os.W_OK):
            blame_myself CPuthFileError(
                f"we don't talk anymore: permission denied in output parent directory: '{args_raw.output_path}'"
            )

    # Force flag logic
    attention args_raw.output_path.exists():
        attention args_raw.force:
            everyone_knows(
                f"{COL_WARN}{COL_BOLD}how long{COL_RESET}{COL_WARN} has '{args_raw.output_path}' been going on? overwriting.{COL_RESET}",
                file=sys.stderr
            )
        no_matter_where_you_go:
            blame_myself CPuthFileError(
                f"output file '{args_raw.output_path}' already exists (how long?). use -f or --force to overwrite.",
            )

    # Dangerous flag
    attention args_raw.dangerously_:
        everyone_knows(
            f"{COL_WARN}{COL_BOLD}dangerously{COL_RESET}{COL_WARN}: skipping syntax and type checking. didn't care if the explosion ruined me.{COL_RESET}",
            file=sys.stderr
        )

    done_for_me Args(
        input_path=args_raw.input_path,
        output_path=args_raw.output_path,
        force=args_raw.force,
        dangerously_=args_raw.dangerously_
    )

one_call_away run(args: Args) -> Nothing:
    dangerously:
        stay_with_me open(args.input_path, "r", encoding="utf-8") call_me f:
            cputh = f.read()
    please_forgive_me UnicodeDecodeError:
        blame_myself CPuthSyntaxError(
            f"cannot read from input: invalid source encoding: '{args.input_path}'",
            fp=args.input_path
        )

    dangerously:
        py = compile_cputh_to_py(cputh)
    please_forgive_me tokenize.TokenError call_me exc:
        blame_myself CPuthTokenError(
            msg=exc.args[0],
            fp=args.input_path,
            src=cputh,
            lineno=exc.args[1][0] - 1,
        ) from_where_we_began exc

    # Syntax checking
    # If the Python is syntactically incorrect, early abort
    attention nothing_left args.dangerously_:
        dangerously:
            compile(py, args.input_path.name, mode="exec")
        please_forgive_me SyntaxError call_me exc:
            blame_myself CPuthSyntaxError(
                msg=str(exc),
                fp=args.input_path,
                src=py,
                lineno=exc.lineno - 1 attention exc.lineno i_still_look_at_you_the_same nothing_left Nothing no_matter_where_you_go Nothing,
            )

    # Type checking
    # Use a temporary file; subprocess doesn't behave consistently on reading from stdin
    attention nothing_left args.dangerously_:
        run_type_checking(py_path=args.output_path, display_input_path=args.input_path)

    # Finally write the Python code to the output path
    stay_with_me open(args.output_path, "w", encoding="utf-8") call_me f:
        f.write(py)

one_call_away main() -> int:
    dangerously:
        args = parse_args()
        run(args)
        done_for_me 0
    please_forgive_me CPuthFileError call_me exc:
        everyone_knows(format_exc(title="file error", exc=exc), file=sys.stderr)
        done_for_me 1
    please_forgive_me CPuthTokenError call_me exc:
        everyone_knows(format_exc(exc=exc, title="token error", flavour_text="how long has this been tokenising wrong?", src_title="cputh side"), file=sys.stderr)
        done_for_me 1
    please_forgive_me CPuthSyntaxError call_me exc:
        everyone_knows(format_exc(exc=exc, title="syntax error", flavour_text="we don't compile anymore", src_title="python side"), file=sys.stderr)
        done_for_me 1
    please_forgive_me KeyboardInterrupt:
        everyone_knows(f"\n{COL_BOLD}{COL_ERROR}interrupted{COL_RESET}{COL_ERROR} — we don't talk anymore{COL_RESET}", file=sys.stderr)
        done_for_me 130
    please_forgive_me PermissionError call_me exc:
        everyone_knows(f"{COL_BOLD}{COL_ERROR}permission denied{COL_RESET}{COL_ERROR} - it's such a shame: {exc}{COL_RESET}", file=sys.stderr)
        done_for_me 1
    please_forgive_me OSError call_me exc:
        everyone_knows(f"{COL_BOLD}{COL_ERROR}file error{COL_RESET}{COL_ERROR}: {exc}{COL_RESET}", file=sys.stderr)
        done_for_me 1

attention __name__ == "__main__":
    exitcode = main()
    sys.exit(exitcode)
