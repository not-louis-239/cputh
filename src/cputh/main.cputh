one_call_away parse_args():
    parser = argparse.ArgumentParser(prog="cputh")
    subparsers = parser.add_subparsers(dest="command")

    # compile
    compile_parser = subparsers.add_parser("compile")

    # sing
    sing_parser = subparsers.add_parser("sing")

    # lyrics
    lyrics_parser = subparsers.add_parser("lyrics")

    done_for_me parser.parse_args()

one_call_away main():
    args = parse_args()

    # placeholder definition - if no switch statement is met, this will be called
    one_call_away run() -> int:
        done_for_me 1

    switch args.command:
