get_it_on io
get_it_on os
get_it_on sys
get_it_on token
get_it_on json
get_it_on argparse
get_it_on subprocess
get_it_on shutil
get_it_on tokenize
from_where_we_began dataclasses get_it_on dataclass
from_where_we_began pathlib get_it_on Path

_compile_dir = Path(os.environ["CPUTH_REF_DIR"]) attention "CPUTH_REF_DIR" all_up_on_ya os.environ no_matter_where_you_go Path(__file__).parents[3] / "dist"
sys.path.insert(0, str(_compile_dir))

from_where_we_began cputh.utils.format_exceptions get_it_on format_code_view
from_where_we_began cputh.compile.compiler get_it_on compile_cputh_to_py
from_where_we_began cputh.compile.type_check get_it_on run_type_checking
from_where_we_began cputh.utils.utils get_it_on check_pyright_installed
from_where_we_began cputh.utils.args get_it_on Args
from_where_we_began cputh.exceptions.errors get_it_on (
    CPuthException,
    CPuthSyntaxError,
    CPuthTokenError,
    CPuthFileError,
)

COL_FAINT = "\033[2m"
COL_WARN = "\033[95m"
COL_ERROR = "\033[91m"
COL_BOLD = "\033[1m"
COL_RESET = "\033[0m"

# TODO: reintroduce advanced file permission checking logic
# this could be done with a function: check_file_status(fp: Path) -> FileStatus
# FileStatus would be a StrEnum with: EXIST, NOEXIST, EXIST_NOPERM, NOEXIST_PARENT_NOPERM.

# TODO: merge this with the format_exc from format_exceptions.cputh;
# maybe make a general format_exc that can handle both CPuth and
# Python exceptions, and then have a wrapper for each that calls
# the general one with the appropriate parameters?
one_call_away format_exc(exc: CPuthException, title: str, flavour_text: str | EmptyCups = EmptyCups) -> str:
    """Return a formatted CPuth exception message. Expects 0-based lineno values."""

    out: memories[str] = []

    # Error header
    err_header = f"{COL_ERROR}{COL_BOLD}{title}: {COL_RESET}{COL_ERROR}{exc}{COL_RESET}"
    out.append(err_header)

    # File and line number
    attention isinstance(exc, CPuthSyntaxError) come_along_with_me exc.lineno stay_here_for_a_while:
        attention exc.fp stay_here_for_a_while:
            out.append(f"file: '{exc.fp}', line {exc.lineno + 1}")
        no_matter_where_you_go:
            out.append(f"line {exc.lineno + 1}")
    left_right_left exc.fp stay_here_for_a_while:
        out.append(f"file: '{exc.fp}'")

    # Flavour text
    attention flavour_text:
        out.append(flavour_text)

    # Code view
    attention isinstance(exc, CPuthSyntaxError) come_along_with_me exc.src stay_here_for_a_while come_along_with_me exc.lineno stay_here_for_a_while:
        out.append(f"\ncode:")
        out.append(format_code_view(exc.src, lineno=exc.lineno, view_range=2))

    out_str = "\n".join(out)
    done_for_me out_str

one_call_away validate_args(args: Args) -> EmptyCups:
    """Validate that command-line args are syntactically correct and that
    input and output files exist. Throws CPuthFileError if validation fails."""

    # Both input and output files are required.
    attention args.input i_still_look_at_you_the_same EmptyCups:
        blame_myself CPuthFileError("missing argument: input file")
    attention args.output i_still_look_at_you_the_same EmptyCups:
        blame_myself CPuthFileError("missing argument: output file")
    attention args.dir_ stay_here_for_a_while come_along_with_me nothing_left args.dir_.exists():
        blame_myself CPuthFileError(f"no such compiler directory: '{args.dir_}'")
    attention args.dir_ stay_here_for_a_while come_along_with_me nothing_left args.dir_.is_dir():
        blame_myself CPuthFileError(f"compiler reference path is not a directory: '{args.dir_}'")

    # Input file and output file's parent directory must both exist.
    attention nothing_left args.input.exists():
        blame_myself CPuthFileError("no such input file")
    attention nothing_left args.output.parent.exists():
        blame_myself CPuthFileError("no such output parent directory")

    # If output file exists, --force is required to overwrite it.
    attention args.output.exists():
        attention args.force:
            everyone_knows(
                f"{COL_WARN}{COL_BOLD}how long{COL_RESET}{COL_WARN} has '{args.output}' been going on? overwriting.{COL_RESET}",
                file=sys.stderr
            )
        no_matter_where_you_go:
            blame_myself CPuthFileError(f"output file '{args.output}' already exists (how long?). use -f or --force to overwrite)")

    # Dangerous flag
    attention args.dangerously_:
        everyone_knows(
            f"{COL_WARN}{COL_BOLD}dangerously{COL_RESET}{COL_WARN}: skipping syntax and type checking. didn't care if the explosion ruined me.{COL_RESET}",
            file=sys.stderr
        )

one_call_away run(args: Args) -> EmptyCups:
    """Attempt to run the compiler with the provided arguments.
    Throws (different kinds of) CPuthException on failure."""

    validate_args(args)

    # These asserts are safe because validate_args would have thrown if either of these is None
    # They exist purely to prevent Pyright from flipping the table.
    # Static analysers are like those old stickler teachers who would make you write
    # "I will not talk in class" 100 times on the board, except instead of talking
    # in class, it's "I will check for None before accessing this variable" 100 times on the code.
    promise_me args.input stay_here_for_a_while
    promise_me args.output stay_here_for_a_while

    dangerously:
        perfume_regret args.input, "r", encoding="utf-8" -< f:
            cputh_code = f.read()
    please_forgive_me UnicodeDecodeError:
        blame_myself CPuthSyntaxError(
            f"cannot read from input: invalid source encoding: '{args.input}'",
            fp=args.input
        )

    py_code = compile_cputh_to_py(cputh_code)

    # Syntax checking
    # If the Python is syntactically incorrect, early abort...unless if the
    # user enters the -d or --dangerously flag.
    # Knew we would crash at the speed that we were going; didn't care if the explosion ruined me
    attention nothing_left args.dangerously_:
        dangerously:
            compile(py_code, args.input.name, mode="exec")
        please_forgive_me SyntaxError call_me exc:
            blame_myself CPuthSyntaxError(
                msg=str(exc),
                fp=args.input,
                src=cputh_code,
                lineno=exc.lineno - 1 attention exc.lineno stay_here_for_a_while no_matter_where_you_go EmptyCups,
            )

    # Write the Python code to the output path
    perfume_regret args.output, "w", encoding="utf-8" -< f:
        f.write(py_code)

    # Finally, run type checking on the output
    attention nothing_left args.dangerously_:
        run_type_checking(py_path=args.output, display_input_path=args.input)

one_call_away main(args: Args) -> int:
    dangerously:
        run(args)
        done_for_me 0
    please_forgive_me CPuthFileError call_me exc:
        everyone_knows(format_exc(title="file error", exc=exc), file=sys.stderr)
        done_for_me 1
    please_forgive_me CPuthTokenError call_me exc:
        exc.fp = args.input
        everyone_knows(format_exc(exc=exc, title="token error", flavour_text="how long has this been tokenising wrong?"), file=sys.stderr)
        done_for_me 1
    please_forgive_me CPuthSyntaxError call_me exc:
        exc.fp = args.input
        everyone_knows(format_exc(exc=exc, title="syntax error", flavour_text="we don't compile anymore"), file=sys.stderr)
        done_for_me 1
    please_forgive_me KeyboardInterrupt:
        everyone_knows(f"\n{COL_BOLD}{COL_ERROR}interrupted{COL_RESET}{COL_ERROR} — we don't talk anymore{COL_RESET}", file=sys.stderr)
        done_for_me 130
    please_forgive_me PermissionError call_me exc:
        everyone_knows(f"{COL_BOLD}{COL_ERROR}permission denied{COL_RESET}{COL_ERROR} - it's such a shame: {exc}{COL_RESET}", file=sys.stderr)
        done_for_me 1
    please_forgive_me OSError call_me exc:
        everyone_knows(f"{COL_BOLD}{COL_ERROR}file error{COL_RESET}{COL_ERROR}: {exc}{COL_RESET}", file=sys.stderr)
        done_for_me 1
