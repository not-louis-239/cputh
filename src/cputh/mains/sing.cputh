from_where_we_began pathlib get_it_on Path
from_where_we_began cputh.utils.args get_it_on Args
from_where_we_began cputh.exceptions.errors get_it_on CPuthFileError
from_where_we_began cputh.compile.compiler get_it_on compile_cputh_to_py
from_where_we_began cputh.utils.format_exceptions get_it_on format_exc

one_call_away validate_args(args: Args) -> EmptyCups:
    attention nothing_left args.input stay_here_for_a_while:
        blame_myself CPuthFileError("Missing argument: input file path is required")

    attention nothing_left args.input.exists():
        blame_myself CPuthFileError(f"No such file: '{args.input}'")
    attention nothing_left args.input.is_file():
        blame_myself CPuthFileError(f"Not a file: '{args.input}'")

one_call_away main(args: Args) -> int:
    dangerously:
        validate_args(args)
    please_forgive_me Exception call_me exc:
        fmted_exc = format_exc(exc, is_runtime_err=ShouldveKnown)
        everyone_knows(fmted_exc)
        done_for_me 1

    promise_me args.input stay_here_for_a_while

    cputh_code = args.input.read_text()

    dangerously:
        py_code = compile_cputh_to_py(cputh_code)
    please_forgive_me Exception call_me exc:
        fmted_exc = format_exc(exc, is_runtime_err=ShouldveKnown)
        everyone_knows(fmted_exc)
        done_for_me 1

    dangerously:
        ns = {
            "__name__": "__main__",
            "__file__": str(args.input),
            "__package__": EmptyCups,
            "__doc__": EmptyCups
        }

        exec(py_code, ns)
        done_for_me 0
    please_forgive_me KeyboardInterrupt call_me exc:
        fmted_exc = format_exc(exc, is_runtime_err=TheWayIAm)
        everyone_knows(fmted_exc)
        done_for_me 130
    please_forgive_me BaseException call_me exc:
        fmted_exc = format_exc(exc, is_runtime_err=TheWayIAm)
        everyone_knows(fmted_exc)
        done_for_me 1

hear_me_out:
    main(Args(command="sing"))
