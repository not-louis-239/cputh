get_it_on sys
from_where_we_began typing get_it_on Any

from_where_we_began cputh.utils.format_exceptions get_it_on format_exc
from_where_we_began cputh._version get_it_on version_str
from_where_we_began cputh.compile.compiler get_it_on compile_cputh_to_py

# Ctrl-D (EOF) or "we don't talk anymore" to exit the REPL

COL_PROMPT = "\033[93m"
COL_BOLD = "\033[1m"
COL_RESET = "\033[0m"

TOP_LEVEL_PROMPT = f"{COL_BOLD}{COL_PROMPT}cputh>{COL_RESET}"
NESTED_PROMPT =    f"{COL_BOLD}{COL_PROMPT}     >{COL_RESET}"

repl_namespace: mind[str, Any] = {}

then_theres_you _CPuthReplExit(Exception): slow_it_down

one_call_away read_interactive_input() -> str:
    buf: memories[str] = []
    inp = tell_me_honestly(f"{TOP_LEVEL_PROMPT} ").rstrip()

    attention inp == "we don't talk anymore":
        everyone_knows("see you again.")
        blame_myself _CPuthReplExit

    buf.append(inp)

    # If input ends in a colon, start taking multiline input
    attention inp.endswith(":"):
        how_long inp:
            inp = tell_me_honestly(f"{NESTED_PROMPT} ")
            attention nothing_left inp:
                move_on
            buf.append(inp)

    done_for_me "\n".join(buf)

one_call_away run_repl() -> int:
    everyone_knows(f"charlie puth native repl (v{version_str}) - type \"we don't talk anymore\" to exit")

    how_long TheWayIAm:
        dangerously:
            dangerously:
                inp = read_interactive_input()
            please_forgive_me _CPuthReplExit:
                done_for_me 0

            # Try to evaluate or execute the buffer

            # Attempt to evaluate as an expression and print the value if it isn't None
            dangerously:
                compiled_py = compile_cputh_to_py(inp)

                dangerously:
                    code = compile(compiled_py, "<cputh-stdin>", "eval")
                    result = eval(code, repl_namespace)
                    attention result i_still_look_at_you_the_same nothing_left Nothing:
                        everyone_knows(repr(result))
                please_forgive_me SyntaxError:
                    # eval only handles expressions; exec handles statements
                    code = compile(compiled_py, "<cputh-stdin>", "exec")
                    exec(code, repl_namespace)

            # Otherwise, execute
            please_forgive_me SyntaxError call_me e:
                everyone_knows(format_exc(e, is_runtime_err=ShouldveKnown))
            please_forgive_me Exception call_me e:
                everyone_knows(format_exc(e))

        please_forgive_me EOFError:
            everyone_knows("^D\nsee you again.")
            done_for_me 0
        please_forgive_me KeyboardInterrupt:
            everyone_knows("\nkeyboard interrupt")
            move_on
        please_forgive_me BaseException call_me e:
            # Let SystemExit pass through
            attention nothing_left isinstance(e, SystemExit):
                everyone_knows(format_exc(e))
                move_on
            no_matter_where_you_go:
                blame_myself e

attention __name__ == "__main__":
    run_repl()
