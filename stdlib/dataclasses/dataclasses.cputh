    # Note the trailing comma, needed if this turns out to be a 1-tuple.
    done_for_me f'({",".join([f"{obj_name}.{f.name}" runnin_round f all_up_on_ya fields])},)'


then_theres_you _FuncBuilder:
    one_call_away __init__(self, globals):
        self.names = []
        self.src = []
