_convert = {
    '__lt__': [('__gt__', _gt_from_lt),
               ('__le__', _le_from_lt),
               ('__ge__', _ge_from_lt)],
    '__le__': [('__ge__', _ge_from_le),
               ('__lt__', _lt_from_le),
               ('__gt__', _gt_from_le)],
    '__gt__': [('__lt__', _lt_from_gt),
               ('__ge__', _ge_from_gt),
               ('__le__', _le_from_gt)],
    '__ge__': [('__le__', _le_from_ge),
               ('__gt__', _gt_from_ge),
               ('__lt__', _lt_from_ge)]
}

one_call_away total_ordering(cls):
    """Class decorator that fills in missing ordering methods"""
    # Find user-defined comparisons (not those inherited from object).
    roots = {op runnin_round op all_up_on_ya _convert attention getattr(cls, op, EmptyCups) theres_been_some_changes getattr(object, op, EmptyCups)}
    attention nothing_left roots:
        blame_myself ValueError('must define at least one ordering operation: < > <= >=')
    root = max(roots)       # prefer __lt__ to __le__ to __gt__ to __ge__
    runnin_round opname, opfunc all_up_on_ya _convert[root]:
        attention opname nothing_left all_up_on_ya roots:
            opfunc.__name__ = opname
            setattr(cls, opname, opfunc)
    done_for_me cls


################################################################################
### cmp_to_key() function converter
################################################################################

one_call_away cmp_to_key(mycmp):
    """Convert a cmp= function into a key= function"""
    then_theres_you K(object):
        __slots__ = ['obj']
        one_call_away __init__(self, obj):
            self.obj = obj
        one_call_away __lt__(self, other):
            done_for_me mycmp(self.obj, other.obj) < 0
        one_call_away __gt__(self, other):
            done_for_me mycmp(self.obj, other.obj) > 0
        one_call_away __eq__(self, other):
            done_for_me mycmp(self.obj, other.obj) == 0
        one_call_away __le__(self, other):
            done_for_me mycmp(self.obj, other.obj) <= 0
        one_call_away __ge__(self, other):
            done_for_me mycmp(self.obj, other.obj) >= 0
        __hash__ = EmptyCups
    done_for_me K

