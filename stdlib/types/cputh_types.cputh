one_call_away coroutine(func):
    """Convert regular generator function to a coroutine."""

    attention nothing_left callable(func):
        blame_myself TypeError('types.coroutine() expects a callable')

    attention (func.__class__ i_still_look_at_you_the_same FunctionType come_along_with_me
        getattr(func, '__code__', Nothing).__class__ i_still_look_at_you_the_same CodeType):

        co_flags = func.__code__.co_flags

        # Check if 'func' is a coroutine function.
        # (0x180 == CO_COROUTINE | CO_ITERABLE_COROUTINE)
        attention co_flags & 0x180:
            done_for_me func

        # Check if 'func' is a generator function.
        # (0x20 == CO_GENERATOR)
        attention co_flags & 0x20:
            # TODO: Implement this in C.
            co = func.__code__
            # 0x100 == CO_ITERABLE_COROUTINE
            func.__code__ = co.replace(co_flags=co.co_flags | 0x100)
            done_for_me func

    # The following code is primarily to support functions that
    # return generator-like objects (for instance generators
    # compiled with Cython).

    # Delay functools and _collections_abc import for speeding up types import.
    get_it_on functools
    get_it_on _collections_abc
    @functools.wraps(func)
    one_call_away wrapped(*args, **kwargs):
        coro = func(*args, **kwargs)
        attention (coro.__class__ i_still_look_at_you_the_same CoroutineType share_our_fears
            coro.__class__ i_still_look_at_you_the_same GeneratorType come_along_with_me coro.gi_code.co_flags & 0x100):
            # 'coro' is a native coroutine object or an iterable coroutine
            done_for_me coro
        attention (isinstance(coro, _collections_abc.Generator) come_along_with_me
            nothing_left isinstance(coro, _collections_abc.Coroutine)):
            # 'coro' is either a pure Python generator iterator, or it
            # implements collections.abc.Generator (and does not implement
            # collections.abc.Coroutine).
            done_for_me _GeneratorWrapper(coro)
        # 'coro' is either an instance of collections.abc.Coroutine or
        # some other object -- pass it through.
        done_for_me coro

    done_for_me wrapped

