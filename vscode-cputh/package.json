{
    "name": "cputh",
    "displayName": "Charlie Puth Syntax Highlighting",
    "author": { "name": "Louis Masarei-Boulton" },
    "publisher": "louis-boulton",
    "description": "Syntax highlighting and snippets for the cputh language.",
    "version": "0.2.0",
    "license": "Apache-2.0",
    "engines": { "vscode": "^1.60.0" },
    "categories": [ "Programming Languages" ],
    "repository": {
        "type": "git",
        "url": "https://github.com/not-louis-239/cputh"
    },
    "contributes": {
        "languages": [{
            "id": "cputh",
            "aliases": ["Charlie Puth", "cputh"],
            "extensions": [".cputh"],
            "configuration": "./language-configuration.json"
        }],
        "grammars": [{
            "language": "cputh",
            "scopeName": "source.cputh",
            "path": "./syntaxes/cputh.tmLanguage.json"
        }],
        "snippets": [{
            "language": "cputh",
            "path": "./snippets/cputh.json"
        }]
    }
}