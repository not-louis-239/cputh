{
    "name": "cputh",
    "scopeName": "source.cputh",
    "fileTypes": [ "cputh" ],
    "patterns": [
        { "include": "#keywords" },
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#types" },
        { "include": "#params" },
        { "include": "#variables" },
        { "include": "#operators" },
        { "include": "#constants" }
    ],
    "repository": {
        "keywords": {
            "patterns": [
                {
                    "comment": "control flow",
                    "name": "keyword.control.flow.cputh",
                    "match": "\\b(promise_me|attention|left_right_left|no_matter_where_you_go|how_long|goin_round|we_dont_talk_anymore|move_on|slow_it_down|done_for_me|cheating_on_you)\\b"
                },
                {
                    "comment": "exceptions",
                    "name": "keyword.control.exception.cputh",
                    "match": "\\b(dangerously|please_forgive_me|see_you_again|blame_myself)\\b"
                },
                {
                    "comment": "imports",
                    "name": "keyword.control.import.cputh",
                    "match": "\\b(from_where_we_began|get_it_on)\\b"
                },
                {
                    "comment": "context",
                    "name": "keyword.control.context.cputh",
                    "match": "\\b(stay_with_me|call_me)\\b"
                },
                {
                    "comment": "scope",
                    "name": "keyword.control.scope.cputh",
                    "match": "\\b(this_whole_world|not_alone|erase)\\b"
                },
                {
                    "comment": "async",
                    "name": "keyword.control.async.cputh",
                    "match": "\\b(i_still_can_hear_you|it_wont_be_long)\\b"
                },
                {
                    "comment": "augmented assignment operators - defined above regular assignment operators to take priority",
                    "name": "keyword.operator.assignment.cputh",
                    "match": "(\\+=|-=|\\*=|/=|//=|%=|\\*\\*=|&=|\\|=|\\^=|>>=|<<=)"
                },
                {
                    "comment": "annotations",
                    "name": "punctuation.separator.annotation.result.cputh",
                    "match": "->"
                },
                {
                    "comment": "ellipsis",
                    "name": "constant.other.ellipsis.cputh",
                    "match": "\\.\\.\\."
                },
                {
                    "comment": "positional-only separator",
                    "name": "variable.parameter.positional-only.cputh",
                    "match": "(?<=,\\s*)(\\/)"
                },
                {
                    "comment": "keyword-only separator",
                    "name": "variable.parameter.keyword-only.cputh",
                    "match": "(?<=,\\s*)(\\*)"
                },
                {
                    "comment": "function definition: keyword, name, and opening paren",
                    "match": "\\b(one_call_away)\\s+([a-z_][a-zA-Z0-9_]*)\\s*(\\()",
                    "captures": {
                        "1": {
                            "name": "storage.type.function.cputh"
                        },
                        "2": {
                            "name": "entity.name.function.cputh"
                        },
                        "3": {
                            "name": "punctuation.definition.parameters.begin.cputh"
                        }
                    }
                },
                {
                    "comment": "class definition: keyword followed by class name",
                    "match": "\\b(then_theres_you)\\s+([A-Z][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "storage.type.class.cputh"
                        },
                        "2": {
                            "name": "entity.name.type.class.cputh"
                        }
                    }
                }
            ]
        },
        "comments": {
            "patterns": [
                {
                    "comment": "docstrings",
                    "name": "string.quoted.docstring.multi.cputh",
                    "begin": "\"\"\"",
                    "end": "\"\"\"",
                    "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.cputh" } },
                    "endCaptures": { "0": { "name": "punctuation.definition.string.end.cputh" } }
                },
                {
                    "comment": "line comments",
                    "name": "comment.line.number-sign.cputh",
                    "match": "#.*$"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.cputh",
                    "begin": "\"",
                    "end": "\"",
                    "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.cputh" } },
                    "endCaptures": { "0": { "name": "punctuation.definition.string.end.cputh" } },
                    "patterns": [
                        { "name": "constant.character.escape.cputh", "match": "\\\\." }
                    ]
                },
                {
                    "name": "string.quoted.single.cputh",
                    "begin": "'",
                    "end": "'",
                    "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.cputh" } },
                    "endCaptures": { "0": { "name": "punctuation.definition.string.end.cputh" } },
                    "patterns": [
                        { "name": "constant.character.escape.cputh", "match": "\\\\." }
                    ]
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "comment": "i/o - both cputh and vanilla python",
                    "name": "support.function.builtin.cputh",
                    "match": "\\b(everyone_knows|tell_me_honestly|open|len|eval|exec)\\b"
                },
                {
                    "comment": "data structure types - include cputh and vanilla python",
                    "name": "support.type.cputh",
                    "match": "\\b(lightswitch|memories|mind|str|float|tuple|int|set|frozenset|bytes|bytearray|memoryview|slice)\\b"
                }
            ]
        },
        "params": {
            "patterns": [

            ]
        },
        "variables": {
            "patterns": [
                {
                    "comment": "function, method or class call",
                    "match": "\\b([a-zA-Z_]\\w*)\\s*(?=\\()",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.call.cputh"
                        }
                    }
                },
                {
                    "comment": "special variable names - self, cls",
                    "name": "variable.language.special.cputh",
                    "match": "\\b(self|cls)\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "comment": "assignment operators",
                    "name": "keyword.operator.assignment.cputh",
                    "match": "(?<![=!<>])=(?!=)"
                },
                {
                    "comment": "logical operators",
                    "name": "keyword.operator.logical.cputh",
                    "match": "\\b(==|!=|<=|>=|<|>|i_still_look_at_you_the_same|all_up_on_ya|nothing_left|come_along_with_me|share_our_fears)\\b"
                },
                {
                    "comment": "arithmetic operators",
                    "name": "keyword.operator.arithmetic.cputh",
                    "match": "(\\+|-|\\*\\*|\\*|//|/|%)"
                },
                {
                    "comment": "bitwise operators",
                    "name": "keyword.operator.bitwise.cputh",
                    "match": "(&|\\||\\^|~|<<|>>)"
                },
                {
                    "comment": "punctuation — separators",
                    "name": "punctuation.separator.cputh",
                    "match": "(,|;)"
                },
                {
                    "comment": "punctuation — colon",
                    "name": "punctuation.separator.colon.cputh",
                    "match": ":"
                },
                {
                    "comment": "punctuation — dot / attribute access",
                    "name": "punctuation.accessor.cputh",
                    "match": "\\."
                },
                {
                    "comment": "punctuation — brackets",
                    "name": "punctuation.brackets.cputh",
                    "match": "[\\(\\)\\[\\]\\{\\}]"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "comment": "language-specific constants",
                    "name": "constant.language.cputh",
                    "match": "\\b(TheWayIAm|ShouldveKnown|Nothing)\\b"
                },
                {
                    "comment": "SCREAMING_SNAKE_CASE constants",
                    "name": "constant.other.caps.cputh",
                    "match": "\\b[A-Z][A-Z0-9_]+\\b"
                },
                {
                    "comment": "float — scientific notation",
                    "name": "constant.numeric.float.scientific.cputh",
                    "match": "\\b([0-9][0-9_]*\\.?[0-9_]*)([eE][+-]?[0-9][0-9_]*)\\b"
                },
                {
                    "comment": "float — decimal",
                    "name": "constant.numeric.float.cputh",
                    "match": "\\b([0-9][0-9_]*\\.[0-9_]*)\\b|\\b(\\.[0-9][0-9_]*)\\b"
                },
                {
                    "comment": "integer — hexadecimal",
                    "name": "constant.numeric.integer.hexadecimal.cputh",
                    "match": "\\b(0[xX][0-9a-fA-F][0-9a-fA-F_]*)\\b"
                },
                {
                    "comment": "integer — octal",
                    "name": "constant.numeric.integer.octal.cputh",
                    "match": "\\b(0[oO][0-7][0-7_]*)\\b"
                },
                {
                    "comment": "integer — binary",
                    "name": "constant.numeric.integer.binary.cputh",
                    "match": "\\b(0[bB][01][01_]*)\\b"
                },
                {
                    "comment": "integer — decimal",
                    "name": "constant.numeric.integer.cputh",
                    "match": "\\b([0-9][0-9_]*)\\b"
                }
            ]
        }
    }
}