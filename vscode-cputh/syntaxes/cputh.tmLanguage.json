{
    "name": "cputh",
    "scopeName": "source.cputh",
    "fileTypes": [ "cputh" ],
    "patterns": [
        { "include": "#keywords" },
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#constants" },
        { "include": "#builtins" },
        { "include": "#identifiers" },
        { "include": "#variables" },
        { "include": "#operators" }
    ],
    "repository": {
        "keywords": {
            "patterns": [
                {
                    "comment": "control flow",
                    "name": "keyword.control.flow.cputh",
                    "match": "\\b(promise_me|attention|left_right_left|no_matter_where_you_go|how_long|runnin_round|we_dont_talk_anymore|move_on|slow_it_down|done_for_me|cheating_on_you|switch|you_got_that|goin_round_in_circles|hear_me_out)\\b"
                },
                {
                    "comment": "exceptions",
                    "name": "keyword.control.exception.cputh",
                    "match": "\\b(dangerously|please_forgive_me|see_you_again|blame_myself)\\b"
                },
                {
                    "comment": "raise NotImplementedError shorthand",
                    "name": "keyword.control.exception.not_implemented.cputh",
                    "match": "\\bi_wouldnt_know_what_to_do\\b"
                },
                {
                    "comment": "null coalescence - equivalent of is not None",
                    "name": "keyword.control.null_coalescence.cputh",
                    "match": "\\b(stay_here_for_a_while)\\b"
                },
                {
                    "comment": "future imports shorthand",
                    "name": "keyword.control.import.future.cputh",
                    "match": "\\bmarvin_gaye\\b"
                },
                {
                    "comment": "imports",
                    "name": "keyword.control.import.cputh",
                    "match": "\\b(from_where_we_began|get_it_on)\\b"
                },
                {
                    "comment": "context",
                    "name": "keyword.control.context.cputh",
                    "match": "\\b(stay_with_me|call_me)\\b"
                },
                {
                    "comment": "scope",
                    "name": "keyword.control.scope.cputh",
                    "match": "\\b(this_whole_world|not_alone|erase)\\b"
                },
                {
                    "comment": "async",
                    "name": "keyword.control.async.cputh",
                    "match": "\\b(i_still_can_hear_you|it_wont_be_long)\\b"
                },
                {
                    "comment": "augmented assignment operators - defined above regular assignment operators to take priority",
                    "name": "keyword.operator.assignment.cputh",
                    "match": "(\\+=|-=|\\*=|/=|//=|%=|\\*\\*=|&=|\\|=|\\^=|>>=|<<=|:=)"
                },
                {
                    "comment": "ellipsis",
                    "name": "constant.other.ellipsis.cputh",
                    "match": "\\.\\.\\."
                },
                {
                    "comment": "positional-only separator",
                    "name": "variable.parameter.positional-only.cputh",
                    "match": "(?<=,\\s*)(\\/)"
                },
                {
                    "comment": "keyword-only separator",
                    "name": "variable.parameter.keyword-only.cputh",
                    "match": "(?<=,\\s*)(\\*)"
                },
                {
                    "comment": "anonymous function",
                    "name": "storage.type.function.anonymous.cputh",
                    "match": "\\bsmaller_talks\\b"
                },
                {
                    "comment": "identity checks - equivalent of is and is not",
                    "name": "keyword.operator.identity.cputh",
                    "match": "\\b(i_still_look_at_you_the_same|theres_been_some_changes)\\b"
                },
                {
                    "comment": "logical operators",
                    "name": "keyword.operator.logical.cputh",
                    "match": "\\b(all_up_on_ya|nothing_left|come_along_with_me|share_our_fears)\\b"
                }
            ]
        },
        "comments": {
            "patterns": [
                {
                    "comment": "docstrings",
                    "name": "string.quoted.docstring.multi.cputh",
                    "begin": "\"\"\"",
                    "end": "\"\"\"",
                    "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.cputh" } },
                    "endCaptures": { "0": { "name": "punctuation.definition.string.end.cputh" } }
                },
                {
                    "comment": "line comments",
                    "name": "comment.line.number-sign.cputh",
                    "match": "#.*$"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "comment": "f-string double quoted",
                    "name": "string.quoted.double.cputh",
                    "begin": "(f)(\")",
                    "end": "(?<!\\\\)\\\"",
                    "beginCaptures": {
                        "1": { "name": "storage.type.string.cputh" },
                        "2": { "name": "punctuation.definition.string.begin.cputh" }
                    },
                    "endCaptures": {
                        "0": { "name": "punctuation.definition.string.end.cputh" }
                    },
                    "patterns": [
                        { "name": "constant.character.escape.cputh", "match": "\\\\([\\\\'\"abfnrtv]|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|N\\{[^}]+\\}|[0-7]{1,3})" },
                        {
                            "comment": "interpolated expression",
                            "include": "#f-string-interpolation"
                        }
                    ]
                },
                {
                    "comment": "f-string single quoted",
                    "name": "string.quoted.single.cputh",
                    "begin": "(f)(')",
                    "end": "(?<!\\\\)'",
                    "beginCaptures": {
                        "1": { "name": "storage.type.string.cputh" },
                        "2": { "name": "punctuation.definition.string.begin.cputh" }
                    },
                    "endCaptures": {
                        "0": { "name": "punctuation.definition.string.end.cputh" }
                    },
                    "patterns": [
                        { "name": "constant.character.escape.cputh", "match": "\\\\([\\\\'\"abfnrtv]|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|N\\{[^}]+\\}|[0-7]{1,3})" },
                        {
                            "comment": "interpolated expression",
                            "include": "#f-string-interpolation"
                        }
                    ]
                },
                {
                    "name": "string.quoted.double.cputh",
                    "begin": "\"",
                    "end": "(?<!\\\\)\\\"",
                    "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.cputh" } },
                    "endCaptures": { "0": { "name": "punctuation.definition.string.end.cputh" } },
                    "patterns": [
                        { "name": "constant.character.escape.cputh", "match": "\\\\([\\\\'\"abfnrtv]|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|N\\{[^}]+\\}|[0-7]{1,3})" }
                    ]
                },
                {
                    "name": "string.quoted.single.cputh",
                    "begin": "'",
                    "end": "(?<!\\\\)'",
                    "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.cputh" } },
                    "endCaptures": { "0": { "name": "punctuation.definition.string.end.cputh" } },
                    "patterns": [
                        { "name": "constant.character.escape.cputh", "match": "\\\\([\\\\'\"abfnrtv]|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|N\\{[^}]+\\}|[0-7]{1,3})" }
                    ]
                }
            ]
        },
        "f-string-interpolation": {
            "patterns": [
                {
                    "comment": "interpolated expression",
                    "name": "meta.interpolation.cputh",
                    "contentName": "meta.embedded.inline.cputh source.cputh",
                    "begin": "\\{",
                    "end": "\\}",
                    "beginCaptures": {
                        "0": { "name": "punctuation.definition.template.begin.cputh" }
                    },
                    "endCaptures": {
                        "0": { "name": "punctuation.definition.template.end.cputh" }
                    },
                    "patterns": [
                        { "include": "#f-string-interpolation" },
                        { "include": "#keywords" },
                        { "include": "#comments" },
                        { "include": "#strings" },
                        { "include": "#constants" },
                        { "include": "#builtins" },
                        { "include": "#identifiers" },
                        { "include": "#variables" },
                        { "include": "#operators" }
                    ]
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "comment": "language-specific constants",
                    "name": "constant.language.cputh",
                    "match": "\\b(TheWayIAm|ShouldveKnown|Nothing|EmptyCups)\\b"
                },
                {
                    "comment": "SCREAMING_SNAKE_CASE constants",
                    "name": "constant.other.caps.cputh",
                    "match": "\\b[A-Z_][A-Z0-9_]+\\b"
                },
                {
                    "comment": "float — scientific notation",
                    "name": "constant.numeric.float.scientific.cputh",
                    "match": "\\b([0-9][0-9_]*\\.?[0-9_]*)([eE][+-]?[0-9][0-9_]*)\\b"
                },
                {
                    "comment": "float — decimal",
                    "name": "constant.numeric.float.cputh",
                    "match": "\\b([0-9][0-9_]*\\.[0-9_]*)\\b|\\b(\\.[0-9][0-9_]*)\\b"
                },
                {
                    "comment": "integer — hexadecimal",
                    "name": "constant.numeric.integer.hexadecimal.cputh",
                    "match": "\\b(0[xX][0-9a-fA-F][0-9a-fA-F_]*)\\b"
                },
                {
                    "comment": "integer — octal",
                    "name": "constant.numeric.integer.octal.cputh",
                    "match": "\\b(0[oO][0-7][0-7_]*)\\b"
                },
                {
                    "comment": "integer — binary",
                    "name": "constant.numeric.integer.binary.cputh",
                    "match": "\\b(0[bB][01][01_]*)\\b"
                },
                {
                    "comment": "integer — decimal",
                    "name": "constant.numeric.integer.cputh",
                    "match": "\\b([0-9][0-9_]*)\\b"
                }
            ]
        },
        "builtins": {
            "patterns": [
                {
                    "comment": "functions - both cputh and vanilla python",
                    "name": "support.function.builtin.cputh",
                    "match": "\\b(everyone_knows|tell_me_honestly|what_are_you_doin_to_me|open|len|eval|exec|hasattr|setattr|getattr|delattr|hash|repr|id|type|isinstance|issubclass|dir|globals|locals|vars|compile|execfile|raw|range|enumerate|zip|filter|map|reversed)\\b"
                },
                {
                    "comment": "data structure types - include cputh and vanilla python",
                    "name": "support.type.cputh",
                    "match": "\\b(lightswitch|memories|mind|str|float|tuple|int|set|frozenset|bytes|bytearray|memoryview|slice)\\b"
                },
                {
                    "comment": "builtin exceptions",
                    "name": "support.type.exception.cputh",
                    "match": "\\b(BaseException|Exception|TypeError|ValueError|KeyError|IndexError|NameError|AttributeError|FileNotFoundError|SyntaxError|IndentationError|ZeroDivisionError|AssertionError|RuntimeError|ModuleNotFoundError|ImportError|NotImplementedError|KeyboardInterrupt|SystemExit|OSError|EOFError|UserWarning|DeprecationWarning|SyntaxWarning|RuntimeWarning|FutureWarning|PendingDeprecationWarning|PermissionError|OverflowError|RecursionError|Warning|FloatingPointError|TimeoutError|UnboundLocalError|TabError|ArithmeticError|LookupError|(Is|Not)ADirectoryError|StopIteration|MemoryError)\\b"
                }
            ]
        },
        "identifiers": {
            "patterns": [
                {
                    "comment": "builtin decorators",
                    "match": "^\\s*(@)(property|staticmethod|classmethod)\\b",
                    "captures": {
                        "1": { "name": "punctuation.definition.decorator.cputh" },
                        "2": { "name": "support.function.builtin.decorator.cputh" }
                    }
                },
                {
                    "comment": "decorators",
                    "match": "^\\s*(@)([A-Za-z_][a-zA-Z0-9_]*(?:\\.[A-Za-z_][a-zA-Z0-9_]*)*)",
                    "captures": {
                        "1": { "name": "punctuation.definition.decorator.cputh" },
                        "2": { "name": "entity.name.function.decorator.cputh" }
                    }
                },
                {
                    "comment": "magic method definition: keyword, name, and opening paren",
                    "match": "\\b(one_call_away)\\s+(__init__|__add__|__sub__|__mul__|__truediv__|__floordiv__|__hash__|__eq__|__ne__|__lt__|__le__|__gt__|__ge__|__getattr__|__setattr__|__delattr__|__repr__|__str__|__call__|__int__|__len__|__bool__)\\s*(\\()",
                    "captures": {
                        "1": {
                            "name": "storage.type.function.cputh"
                        },
                        "2": {
                            "name": "support.function.magic.cputh"
                        },
                        "3": {
                            "name": "punctuation.definition.parameters.begin.cputh"
                        }
                    }
                },
                {
                    "comment": "function definition: keyword, name, and opening paren",
                    "match": "\\b(one_call_away)\\s+([a-z_][a-zA-Z0-9_]*)\\s*(\\()",
                    "captures": {
                        "1": {
                            "name": "storage.type.function.cputh"
                        },
                        "2": {
                            "name": "entity.name.function.cputh"
                        },
                        "3": {
                            "name": "punctuation.definition.parameters.begin.cputh"
                        }
                    }
                },
                {
                    "comment": "class definition: keyword followed by class name",
                    "match": "\\b(then_theres_you)\\s+([A-Za-z_][a-zA-Z0-9_]*)\\s*(?=[:(])",
                    "captures": {
                        "1": {
                            "name": "storage.type.class.cputh"
                        },
                        "2": {
                            "name": "entity.name.type.class.cputh"
                        }
                    }
                }
            ]
        },
        "variables": {
            "patterns": [
                {
                    "comment": "function, method or class call",
                    "match": "\\b([a-zA-Z_]\\w*)\\s*(?=\\()",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.call.cputh"
                        }
                    }
                },
                {
                    "comment": "special variable names - self, cls",
                    "name": "variable.language.special.cputh",
                    "match": "\\b(self|cls)\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "comment": "annotations",
                    "name": "punctuation.separator.annotation.result.cputh",
                    "match": "->"
                },
                {
                    "comment": "increment",
                    "name": "keyword.operator.increment.cputh",
                    "match": "\\+\\+"
                },
                {
                    "comment": "decrement",
                    "name": "keyword.operator.decrement.cputh",
                    "match": "--"
                },
                {
                    "comment": "assignment operators",
                    "name": "keyword.operator.assignment.cputh",
                    "match": "(?<![=!<>])=(?!=)"
                },
                {
                    "comment": "comparison operators - match 2-char patterns first, then 1-char patterns",
                    "name": "keyword.operator.comparison.cputh",
                    "match": "==|!=|<=|>=|<|>"
                },
                {
                    "comment": "arithmetic operators",
                    "name": "keyword.operator.arithmetic.cputh",
                    "match": "(\\+|-|\\*\\*|\\*|//|/|%)"
                },
                {
                    "comment": "bitwise operators",
                    "name": "keyword.operator.bitwise.cputh",
                    "match": "(&|\\||\\^|~|<<|>>)"
                },
                {
                    "comment": "punctuation - decorator or matrix multiplication operator",
                    "name": "punctuation.definition.decorator.cputh",
                    "match": "@"
                },
                {
                    "comment": "punctuation — separators",
                    "name": "punctuation.separator.cputh",
                    "match": "(,|;)"
                },
                {
                    "comment": "punctuation — colon",
                    "name": "punctuation.separator.colon.cputh",
                    "match": ":"
                },
                {
                    "comment": "punctuation — dot / attribute access",
                    "name": "punctuation.accessor.cputh",
                    "match": "\\."
                },
                {
                    "comment": "punctuation — brackets",
                    "name": "punctuation.brackets.cputh",
                    "match": "[\\(\\)\\[\\]\\{\\}]"
                }
            ]
        }
    }
}
